			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="0" y="222" width="495" height="16" uuid="c8f8a9b0-c1d2-e3f4-a5b6-c7d8e9f0a1b2"/>
				<textElement textAlignment="Left" verticalAlignment="Middle" markup="styled">
					<font fontName="SansSerif" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold=\"true\">Re : </style>Financial assistance to be provided by Sarvagram Fincare Private Limited (the <style isBold=\"true\">\"Lender\"</style>) to the Borrower"]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="0" y="248" width="495" height="55" uuid="d9a9b0c1-d2e3-f4a5-b6c7-d8e9f0a1b2c3"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="SansSerif" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["We refer to your application requesting to grant credit facilities and the subsequent correspondence / discussions and clarifications on the captioned matter. Your proposal has been considered and the Lender is agreeable to offer to the Borrower a loan of INR. " + ($P{amount} != null ? $P{amount} : "__________") + ". (Rupees. " + ($P{amountText} != null ? $P{amountText} : "__________") + " only) (the <style isBold=\"true\">\"Loan\"</style>) on the terms and conditions more particularly mentioned in this Letter and the schedules/annexures attached hereto (the <style isBold=\"true\">\"Sanction Letter\"</style>) and (ii) the <style isBold=\"true\" isUnderline=\"true\">" + ($P{title} != null ? $P{title} : "") + " LOANS - " + ($P{loanType} != null ? $P{loanType} : "") + "</style> agreement to be entered into between the Lender and the Borrower (the <style isBold=\"true\">\"Agreement\"</style>)."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="313" width="495" height="55" uuid="e0b0c1d2-e3f4-a5b6-c7d8-e9f0a1b2c3d4"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="SansSerif" size="10"/>
				</textElement>
				<text><![CDATA[Please note that this communication should not be construed as giving rise to any binding obligation on the part of the Lender with regards to the Loan unless the Lender receives a counterpart of this Sanction Letter duly signed by the Borrower in token of acceptance of the terms and conditions of this Sanction Letter and unless the Agreement and other documents relating to the Loan are executed by the Borrower in such form as may be allowed by the Lender in its absolute discretion.]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="0" y="378" width="495" height="50" uuid="f1c1d2e3-f4a5-b6c7-d8e9-f0a1b2c3d4e5"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="SansSerif" size="10"/>
				</textElement>
				<text><![CDATA[Please note only after due consideration of all the available information (including financial information provided to us by you), we have decided the applicable rate of interest which shall be charged to you, basis inter alia our internal policies, cost of funds, KYC checks carried out by us in this regard, customer profile, credit score and risk management.]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="0" y="438" width="495" height="30" uuid="a2d2e3f4-a5b6-c7d8-e9f0-a1b2c3d4e5f6"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="SansSerif" size="10"/>
				</textElement>
				<text><![CDATA[Final approval/disbursal of the Loan is subject to legal/technical verification by the Lender. The Lender reserves the right to amend any of the terms and conditions hereof at its sole discretion.]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="0" y="480" width="495" height="14" uuid="b3e3f4a5-b6c7-d8e9-f0a1-b2c3d4e5f6a7"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="SansSerif" size="10"/>
				</textElement>
				<text><![CDATA[Yours sincerely,]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="0" y="498" width="495" height="14" uuid="c4f4a5b6-c7d8-e9f0-a1b2-c3d4e5f6a7b8"/>
