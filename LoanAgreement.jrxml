<detail><band height="722" splitType="Stretch"><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="0" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000001"/><textElement textAlignment="Center" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b><u> " + ($P{title}==null?"":String.valueOf($P{title})) + "LOAN AGREEMENT</u></b> "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="16" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000002"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" This Agreement made at " + ($P{branchName}==null?"":String.valueOf($P{branchName})) + " on " + ($P{date}==null?"":String.valueOf($P{date})) + " "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="32" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000003"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>BY AND BETWEEN</b> "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="48" width="535" height="40" uuid="abcd0000-0000-0000-0000-000000000004"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>BORROWER</b> and <b>CO-BORROWER</b> whose details are given in <b>Schedule I</b> hereunder (hereinafter collectively referred to as the <b>“Borrower(s)”</b> which expression shall, unless it be repugnant to the subject or context thereof, include its heirs, executors and permitted assigns), of the <b>FIRST PART</b>; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="88" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000005"/><textElement textAlignment="Center" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>AND</b> "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="104" width="535" height="64" uuid="abcd0000-0000-0000-0000-000000000006"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>SARVAGRAM FINCARE PRIVATE LIMITED</b>, a company registered within the meaning of the Companies Act, 2013 having its registered office at Office No. 22, 4th Floor, Primrose Mall, Baner Road, Baner Gaon, Haveli, Pune - 411045, Maharashtra and among others, a branch office at the place specified in Schedule hereto (hereinafter called the <b>“Lender”</b> which expression shall, unless it be repugnant to the subject or context thereof, include its successors and assigns) of the <b>SECOND PART.</b> "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="168" width="535" height="28" uuid="abcd0000-0000-0000-0000-000000000007"/><textElement textAlignment="Center" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <i>The Borrower(s) and the Lender are hereinafter collectively referred to as <b>“Parties”</b> and individually as the <b>“Party”</b>.</i> "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="196" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000008"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>WHEREAS</b> "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="212" width="513" height="52" uuid="abcd0000-0000-0000-0000-000000000009"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>A.</b>&nbsp; The undersigned Borrower(s) has/ have requested for a loan of the amount and the purpose (“Purpose”) as specified in the Schedule I hereto, (hereinafter referred as “Loan”) and the Lender has agreed to accede to the said request, subject to the Borrower(s) tendering requisite documents, executing present agreement and such documents as may be required by the Lender from time to time. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="266" width="513" height="40" uuid="abcd0000-0000-0000-0000-000000000010"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>B.</b>&nbsp; The Borrower(s) understands that pursuant to Application (as defined below), the Lender shall have the absolute right to grant/ reject/ change the Loan amount/ tenure/ EMI/ rate of interest as per its internal credit policy and the Lender’s decision in this regard shall be final and binding. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="308" width="513" height="28" uuid="abcd0000-0000-0000-0000-000000000011"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>C.</b>&nbsp; The Parties hereto are desirous of recording the terms and conditions in relation to the Loan to be made by the Lender to the Borrower on the terms and conditions hereinafter contained. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="338" width="535" height="28" uuid="abcd0000-0000-0000-0000-000000000012"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>NOW THIS AGREEMENT WITNESSETH AND IT IS HEREBY MUTUALLY AGREED, DECLARED, CONFIRMED AND RECORDED BY AND BETWEEN THE PARTIES HERETO AS FOLLOWS:</b>"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="366" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000013"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>1.</b>&nbsp; <b>DEFINITIONS AND INTERPRETATION</b>   "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="382" width="513" height="28" uuid="abcd0000-0000-0000-0000-000000000014"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>1.1</b> In this Agreement, unless the context otherwise requires, the following terms wherever used including the recitals, shall have the following meanings: "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="410" width="491" height="16" uuid="abcd0000-0000-0000-0000-000000000015"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>a)</b>&nbsp; “<b>Agreement”</b> means this agreement read with the Schedule(s) to this agreement. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="428" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000016"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>b)</b>&nbsp; “<b>Applicable Rate of Interest</b>” means the fixed rate of interest applicable to the Loan, as mentioned in the <b>Schedule I</b>. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="458" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000017"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>c)</b>&nbsp; “<b>Application</b>” means duly filled in application form and the documents submitted by the Borrower to the Lender for the purpose of availing the Loan. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="488" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000018"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>d)</b>&nbsp; “<b>Availability Period</b>” shall mean the period, as specified in the <b>Schedule I</b> during which the Loan shall remain available for drawal by the Borrower(s). "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="518" width="491" height="40" uuid="abcd0000-0000-0000-0000-000000000019"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>e)</b>&nbsp; “<b>Borrower(s)</b>” means one or more individual(s) details of whom are stated in <b>Schedule I</b> to this Agreement and the term Borrower(s), unless repugnant to the subject or context hereof shall be deemed to include legal heirs, representatives, administrators, successors and permitted assigns of the Borrower(s). "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="560" width="491" height="40" uuid="abcd0000-0000-0000-0000-000000000020"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>f)</b>&nbsp; “<b>Branch</b>” means the branch of the Lender at the place mentioned in the <b>Schedule I</b> where the Loan is sanctioned/ disbursed and shall include any other branch where the Loan Account may be maintained or transferred from time to time at the sole discretion of the Lender. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="602" width="491" height="40" uuid="abcd0000-0000-0000-0000-000000000021"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>g)</b>&nbsp; “<b>Business Day</b>” shall mean a day on which the Branch is open for general business as well as for the purposes of payment, settlement and clearing. In case, any date for payment of any dues under this Agreement falls on a day that is not a Business Day, such payments shall be made on the succeeding Business Day. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="644" width="491" height="40" uuid="abcd0000-0000-0000-0000-000000000022"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>h)</b>&nbsp; “<b>Co-Borrower</b>” means one or more individual(s), details of whom are stated in the <b>Schedule I</b> to this Agreement and the term Co-Borrower, unless repugnant to the subject or context hereof shall be deemed to include legal heirs, representatives, administrators, successors and permitted assigns of the Co-Borrower. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="686" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000023"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>i)</b>&nbsp; \"<b>Demand Promissory Note</b>\" means the demand promissory note delivered by the Borrower in the form set out in <b>Schedule II</b>. "]]></textFieldExpression></textField></band><band height="696" splitType="Stretch"><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="0" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000024"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>j)</b>&nbsp; “<b>Equated Monthly Instalment (EMI)/ Equated Periodic Instalment (EPI)</b>” means the amount of pro-rated monthly payment consisting of principal amount of the Loan and/or interest payable thereon. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="30" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000025"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>k)</b>&nbsp; “<b>Loan</b>” means the financial assistance sanctioned under this Agreement for the amount and Purpose as mentioned in the <b>Schedule I</b>. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="60" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000026"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>l)</b>&nbsp; \"<b>Loan Account</b>\" means account opened by the Lender in the name of the Borrower pursuant to the sanction of the Loan and to be operated in accordance with the terms hereof. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="90" width="491" height="40" uuid="abcd0000-0000-0000-0000-000000000027"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>m)</b>&nbsp; \"<b>Loan Documents</b>\" means this Agreement, Sanction Letter, security documents executed by the Borrower and/or Co-Borrower and/or any Person to secure the Loan and/or the performance of the obligations under this Agreement, and any other document(s) designated by the Lender as \"<b>“Loan Document(s)”</b>\". "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="132" width="491" height="52" uuid="abcd0000-0000-0000-0000-000000000028"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>n)</b>&nbsp; \"<b>Penal Charge</b>\" means the charges at the rate as mentioned in <b>Schedule I</b> payable by the Borrower to the Lender over and above the Applicable Rate of Interest upon happening of any event of default as mentioned in the Agreement or failure of the Borrower to pay any other amount due under or in relation to the Loan on its respective due date. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="186" width="491" height="40" uuid="abcd0000-0000-0000-0000-000000000029"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>o)</b>&nbsp; \"<b>Pre-Equated Monthly Interest (P-EMI)</b>\" means interest, at the rate indicated in the Schedule, on the Loan from the date(s) of disbursement of the Loan to the date immediately prior to the date of commencement of EMI. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="228" width="491" height="40" uuid="abcd0000-0000-0000-0000-000000000030"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>p)</b>&nbsp; \"<b>Sanction Letter</b>\" means the letter, if any, issued by the Lender and accepted by the Borrower, in connection with the Loan and would include any variations and amendments thereto, from time to time. Sanction Letter shall form an integral part of this Agreement and shall always be read in conjunction with the same. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="270" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000031"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>q)</b>&nbsp; \"<b>Security</b>\" means security created or agreed to be created by the Borrower(s) in favour of the Lender to secure the Loan and/or the performance of the obligations under this Agreement. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="302" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000032"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>2.</b>&nbsp; <b>LOAN AMOUNT</b>"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="320" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000033"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>3.</b>&nbsp; <b>DISBURSEMENT</b>    "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="336" width="513" height="52" uuid="abcd0000-0000-0000-0000-000000000034"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>3.1</b> The Lender shall, subject to the provisions of this Agreement and unless otherwise agreed to between the Borrower and the Lender, disburse the Loan in one or more tranches by national electronic fund transfer or real time gross settlement systems or by issuing a demand draft or any other mode as the Lender may decide at its sole discretion:  "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="388" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000035"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>a)</b>&nbsp; In the name of the previous financier towards the repayment of the previous loan to be taken over by utilising the Loan; or "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="418" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000036"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>b)</b>&nbsp; In the name of the Borrower(s), at the discretion of the Lender, as per the instructions of the Borrower(s). "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="450" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000037"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>4.</b>&nbsp; <b>INTEREST, FEES/ CHARGES/ COSTS ETC.</b>       "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="466" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000038"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>4.1</b> <b>Interest</b> "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="482" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000039"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>a)</b>&nbsp; The Borrower(s) shall pay to the Lender interest on the principal amount of the Loan outstanding from time to time at a rate equal to the Applicable Rate of Interest as mentioned in the <b>Schedule I</b>. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="512" width="491" height="40" uuid="abcd0000-0000-0000-0000-000000000040"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>b)</b>&nbsp; Notwithstanding anything to the contrary contained in this Agreement, where applicable, the interest payable by the Borrower shall be subject to the applicable regulations/policies/guidelines of the Reserve Bank of India (“<b>RBI</b>”) from time to time. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="554" width="491" height="40" uuid="abcd0000-0000-0000-0000-000000000041"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>c)</b>&nbsp; Applicable Rate of Interest on the Loan shall begin to accrue simultaneously with the Lender’s disbursement of the Loan without the Lender concerning itself with the receipt of such disbursement by the beneficiary/recipient or with the realisation of such demand draft or the time taken in such realisation. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="596" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000042"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>4.2</b> <b>Fees/ Charges/ Costs</b> "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="612" width="491" height="76" uuid="abcd0000-0000-0000-0000-000000000043"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>a)</b>&nbsp; The Borrower(s) has paid/ agreed to pay as and when demanded by the Lender the processing fee, service charges, disbursement charges, collection charges, registration charges, other charges/ fees/ costs etc. as mentioned in the <b>Schedule I</b>/ Sanction Letter or as specified by the Lender from time to time. The Borrower(s) understands and agrees that the foregoing charges/ fees/ costs may be revised by the Lender from time to time. The processing fees, service charge and/or other charges/ fees/ costs shall be non-refundable and would be payable to the Lender whether or not the Loan has been drawn down. "]]></textFieldExpression></textField></band><band height="741" splitType="Stretch"><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="0" width="491" height="100" uuid="abcd0000-0000-0000-0000-000000000044"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>b)</b>&nbsp; The Borrower(s) agrees and covenants with the Lender that the Lender, may at its sole discretion, require the Borrower(s) to promptly pay (i) the applicable stamp duty on this Agreement and also on Loan Documents and such other documents as may be executed in relation to or incidental to these presents; (ii) all present and future taxes which may include any duties, expenses and other charges whatsoever in relation to this Agreement and other Loan Documents, the Loan and the Security; and (iii) all other charges, costs and expenses from time to time specified by the Lender (including all costs and expenses incurred or paid by the Lender) in relation to this Agreement and other Loan Documents and/or any Security including those incurred for repossession and/ or sale of the Security and/ or for recovery of the Loan or any part thereof. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="102" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000045"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>4.3</b> <b>Interest and other charges to be paid prospectively.</b> "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="118" width="513" height="52" uuid="abcd0000-0000-0000-0000-000000000046"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" The Parties agree that in the event of any revision in the Applicable Rate of Interest payable on the Loan by the Borrower, Penal Charge and other fee, charges and costs, such revision shall be applicable prospectively on and from the date of such revision and in no event shall the Borrower(s) be liable to pay any revised Applicable Rate of Interest on the Loan, Penal Charge, and other fee, charges and costs on a retrospective basis."]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="172" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000047"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>5.</b>&nbsp; <b>REPAYMENT</b>                 "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="188" width="513" height="76" uuid="abcd0000-0000-0000-0000-000000000048"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>5.1</b> The Loan (including the EMI or P-EMI, as the case may be, interest thereon and any other charges, premium, fees, taxes levies or other dues payable by the Borrower(s) to the Lender in terms of this Agreement) shall be repayable by the Borrower(s) to the Lender: (i) at the Branch (or at any other branch of the Lender or at any other place as may be notified by the Lender) by way of postdated cheque and/or national automated clearing house or in any other manner as the Lender may specify from time to time in writing; and (ii) by way of EMI as mentioned in the <b>Schedule I</b> towards repayment of principal and interest. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="264" width="513" height="28" uuid="abcd0000-0000-0000-0000-000000000049"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>5.2</b> The Lender shall be under no obligation to give any notice, reminder, or intimation to the Borrower(s) regarding the Borrower(s)’ obligation to duly service the Loan/other dues under this Agreement on each due date. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="292" width="513" height="52" uuid="abcd0000-0000-0000-0000-000000000050"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>5.3</b> Notwithstanding anything to the contrary contained in this Agreement, the Borrower(s) agrees that the Lender shall have the right at any time or from time to time to review and reschedule the repayment terms of the Loan or of the outstanding amount thereof, at its sole discretion. Provided that the Lender shall inform the Borrower(s) of such rescheduling 2 (two) weeks prior to the next due date as per the revised repayment schedule. "]]></textFieldExpression></textField><break><reportElement positionType="Float" x="0" y="344" width="535" height="1" uuid="abcd0000-0000-0000-0000-000000000051"/></break><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="345" width="513" height="112" uuid="abcd0000-0000-0000-0000-000000000052"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>5.4</b> The Borrower(s) undertakes and agrees to pay the interest on the Loan and other costs/charges under this Agreement, free from any deduction whether on account of tax or otherwise. Should any applicable law at any time require any deduction or withholding to be made from a payment, Borrower(s)’ liability in respect of such payment shall be for a revised amount such that after making of such deduction or withholding, the net payment shall be equal to the amount which the Lender would have received, had no such deduction or withholding been made. The Borrower(s) shall hold the Lender harmless and fully indemnified for any claim which may be made in this regard by any tax authorities and undertake to pay forthwith any such demands which the Lender may become liable to pay. If the Borrower(s) fails to pay the amount so demanded by the Lender, then the Borrower(s) hereby authorises the Lender to enforce the Security, for the purpose of recovery of the said tax amount. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="457" width="513" height="88" uuid="abcd0000-0000-0000-0000-000000000053"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>5.5</b> All the charges levied by the Lender/indicated in the Agreement including but not limited to the processing fee, service charges, disbursement charges, collection charges, registration charges, NACH dishonor charges, swap charges and other charges/fees/costs etc. shall be exclusive of all taxes and statutory levies as may be applicable on the same including but not limited to Goods &amp; Service Tax and cesses thereon. The Lender reserves the right to modify the charges including addition of further category of similar charges or waiver of any such charges at its sole discretion. The Borrower(s) absolutely and irrevocably acknowledges and consents that it shall be bound by any such modification in the nature or extent of charges. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="545" width="513" height="76" uuid="abcd0000-0000-0000-0000-000000000054"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>5.6</b> The Borrower(s) agrees, declares and confirms that, notwithstanding any of the provisions of the Indian Contract Act, 1872 or any other applicable law, or any terms and conditions to the contrary contained in this Agreement, the Lender may, at its absolute discretion, appropriate any payments made by the Borrower(s) under this Agreement/ any amounts realized by the Lender by enforcement of Security or otherwise, towards the dues payable by the Borrower(s) to the Lender under this Agreement and/or other agreements entered into between the Borrower(s) and the Lender and in any manner whatsoever. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="621" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000055"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>5.7</b> <b>Delay/default in payment of P-EMI/EMI etc.</b> "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="637" width="513" height="40" uuid="abcd0000-0000-0000-0000-000000000056"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" In the event of default/ delay in payment of any P-EMI(s)/EMI(s) or other monies payable under this Agreement such defaulted amount shall carry Penal Charge, computed from the respective due dates and shall be compounded on daily basis."]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="677" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000057"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>5.8</b> <b>National Automated Clearing House (NACH):</b> "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="693" width="491" height="40" uuid="abcd0000-0000-0000-0000-000000000058"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>a)</b>&nbsp; All the payments, as determined by the Lender, may be collected through NACH and submission of such NACH shall be deemed to be an unconditional and irrevocable authority given by the Borrower(s) to the Lender to present the NACH on their respective due dates. "]]></textFieldExpression></textField></band><band height="738" splitType="Stretch"><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="0" width="491" height="52" uuid="abcd0000-0000-0000-0000-000000000059"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>b)</b>&nbsp; The Borrower(s) expressly agrees not to issue any communication to the Lender requesting to stop or postpone the presentment of the NACH. The Lender is not obligated to acknowledge any such communication, and any issuance of such communication will be considered a breach of this Agreement. Further, the Borrower(s) shall not issue stop payment, or any other similar instruction to its bank with respect to such NACH. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="54" width="491" height="64" uuid="abcd0000-0000-0000-0000-000000000060"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>c)</b>&nbsp; The Borrower(s) agrees in the event of any dishonour of NACH instruction, the Borrower(s) agrees to pay dishonour charges, in addition to any Penal Charges that may be levied by the Lender. Notwithstanding anything contained herein it is clarified that this provision shall not in any way restrict the Lender’s right to initiate appropriate proceedings against the Borrower(s) under the applicable law including the Negotiable Instruments Act, 1881 and Payment and Settlement Systems Act, 2007. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="120" width="491" height="16" uuid="abcd0000-0000-0000-0000-000000000061"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>d)</b>&nbsp; The Borrower(s) undertakes that in the event of any variation in:  "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="66" y="136" width="469" height="16" uuid="abcd0000-0000-0000-0000-000000000062"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>I.</b>&nbsp; the date of payment of P-EMI/EMI or any other amount payable under this Agreement; or "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="66" y="154" width="469" height="16" uuid="abcd0000-0000-0000-0000-000000000063"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>II.</b>&nbsp; the amount of interest, principal or P-EMI(s)/EMIs; or "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="66" y="172" width="469" height="16" uuid="abcd0000-0000-0000-0000-000000000064"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>III.</b>&nbsp; the numbers thereof, "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="192" width="491" height="40" uuid="abcd0000-0000-0000-0000-000000000065"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>e)</b>&nbsp; The Borrower(s) hereby undertakes that the Borrower(s) shall not close/ change the account on which the NACH is issued and also shall not change the authorized signatory/ies to the said account without the prior consent of the Lender. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="234" width="491" height="52" uuid="abcd0000-0000-0000-0000-000000000066"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>f)</b>&nbsp; Notwithstanding anything to the contrary contained in this Agreement and irrespective of the mode of repayment selected by the Borrower(s), upon any default by the Borrower(s) in repayment of any of the EMI/ P-EMI/ any other amount due under the Agreement, the Lender shall be entitled, without prejudice to its other rights under the Agreement or law, to present and/or re-present the NACH registered in favour of the Lender. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="288" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000067"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>5.9</b> <b>Prepayment of Loan</b> "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="304" width="491" height="52" uuid="abcd0000-0000-0000-0000-000000000068"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>a)</b>&nbsp; The Lender may, at its sole discretion and on such terms as to pre-payment fees, etc., as it may prescribe from time to time, permit pre-payment or acceleration of P-EMIs/EMIs at the request of the Borrower(s). Subject to the applicable laws and if permitted by the Lender, the Borrower(s) shall pay to the Lender such pre-payment charges mentioned in the <b>Schedule I</b>, as amended from time to time. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="358" width="491" height="64" uuid="abcd0000-0000-0000-0000-000000000069"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>b)</b>&nbsp; Subject to above, if the Borrower(s) pre-pays only a part of the Loan, the Lender shall be entitled to adjust the amount pre-paid against the amount payable by the Borrower(s) in such manner as the Lender thinks fit. In such an event the Lender shall be entitled to reschedule the repayment schedule at its sole discretion and the Borrower(s) agrees to adhere to such altered re-payment schedule. A copy of such altered repayment schedule shall be provided to the Borrower(s) for its information and records. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="424" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000070"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>5.10</b> <b>Recall of the Loan by the Lender:</b> "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="440" width="513" height="64" uuid="abcd0000-0000-0000-0000-000000000071"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" The Borrower(s) agrees that the Lender shall be entitled to, at any time, in its discretion, recall the Loan by giving to the Borrower(s) 7 (seven) days’ notice in writing, which period the Borrower(s) agrees is a reasonable notice period. It is specified that the repayment schedule set out in the <b>Schedule I</b> is without prejudice to the Lender’s right to recall the entire Loan and to demand payment of the Loan. Upon the expiry of the period of notice, if any given, the Loan shall immediately stand repayable by the Borrower(s) to the Lender."]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="506" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000072"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>6.</b>&nbsp; <b>SECURITY</b>                "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="522" width="513" height="28" uuid="abcd0000-0000-0000-0000-000000000073"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>6.1</b> The repayment of the Loan, interest, Penal Charge, fees, costs, charges and expenses and all other amounts payable under this Agreement to the Lender shall be secured as stipulated in the Sanction Letter, including by: "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="550" width="491" height="16" uuid="abcd0000-0000-0000-0000-000000000074"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>a)</b>&nbsp; way of first exclusive charge by way of mortgage in favour of the Lender over the Security; and/ or "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="568" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000075"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>b)</b>&nbsp; any other security as specified in the <b>Schedule I</b> or as may be specified from time to time by the Lender. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="598" width="513" height="40" uuid="abcd0000-0000-0000-0000-000000000076"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>6.2</b> The Borrower(s) shall execute Loan Documents as per the requirements of the Lender. The Borrower(s) shall furnish such bonds, promissory notes, undertakings and other documents as may be required by the Lender from time to time for the purpose of securing the Loan.  "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="638" width="513" height="40" uuid="abcd0000-0000-0000-0000-000000000077"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>6.3</b> The Lender shall have the right to decide, at its sole discretion the place, timing and the manner of creation of charge over the Security or creation of any other security/additional security by the Borrower(s) for securing the Loan and all other amounts under this Agreement.  "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="678" width="513" height="52" uuid="abcd0000-0000-0000-0000-000000000078"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>6.4</b> The Lender shall be entitled to call upon the Borrower(s) and the Borrower(s) shall be liable to furnish to the Lender additional security as decided by the Lender in the event of the dues being more than the market value of the Security (as may be assessed by the Lender from time to time and the same shall be final and binding on the Borrower) or otherwise required by the Lender.  "]]></textFieldExpression></textField></band><band height="746" splitType="Stretch"><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="0" width="513" height="40" uuid="abcd0000-0000-0000-0000-000000000079"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>6.5</b> The Borrower(s) shall not sell, charge, lease, surrender, assign, transfer, let, further encumber or otherwise howsoever alienate, transfer, create interest in favour of any other person or deal with/in the Security or any part thereof during the continuation of the obligations under this Agreement.  "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="40" width="513" height="64" uuid="abcd0000-0000-0000-0000-000000000080"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>6.6</b> The Borrower(s) shall, if required by the Lender, (i) comprehensively insure and keep insured the Security with an insurance company against loss by fire, earthquake, floods and any loss or damage to the Security due to any force majeure or Act of God or other damages; (ii) obtain insurance cover against the risk of death and injury to the Borrower(s), with the Lender as sole beneficiary and submit to the Lender original insurance policy document(s) and premium payment receipts thereof.  "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="104" width="513" height="64" uuid="abcd0000-0000-0000-0000-000000000081"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>6.7</b> The Security (created or cause to be created) shall remain a continuing security to the Lender binding upon the Borrower(s) and shall not be discharged by intermediate payment by the Borrower(s) or any settlement of accounts by the Borrower(s) and shall be in addition and not in derogation of any other security which the Lender may at any time hold in respect of the dues and be available to the Lender until all accounts between the Lender and the Borrower(s) are ultimately settled.  "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="168" width="513" height="64" uuid="abcd0000-0000-0000-0000-000000000082"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>6.8</b> The Borrower(s) acknowledges that in the event of repayment by the Borrower(s) of the Loan and other amounts due under this Agreement but there being any outstanding by the Borrower(s) under any other financial facility availed of by the Borrower from the Lender or any other person from the Lender, then in such event, the Lender shall not be obliged to release the Security and the Borrower(s) hereby undertakes to execute all the necessary agreements, documents, authorisations, etc. to extend the Security to cover such outstanding financial facility.  "]]></textFieldExpression></textField><break><reportElement positionType="Float" x="0" y="232" width="535" height="1" uuid="abcd0000-0000-0000-0000-000000000083"/></break><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="233" width="513" height="40" uuid="abcd0000-0000-0000-0000-000000000084"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>6.9</b> The Borrower(s) agrees to maintain such security margin as may be stipulated by the Lender. The Borrower(s) also agrees that the security offered for one facility shall be additional security for all other credit facilities.  "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="273" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000085"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>6.10</b> <b>Lender’s right of general lien and set off</b> "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="289" width="491" height="52" uuid="abcd0000-0000-0000-0000-000000000086"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>a)</b>&nbsp; The Borrower agrees and acknowledges that the Lender has an absolute right to settle any indebtedness whatsoever owed by the Borrower to the Lender under this Agreement or under any other document/agreement, by adjusting, setting-off any deposit(s) and/or transferring monies lying to the balance of any account(s) held by the Borrower with the Lender without giving a notice to the Borrower. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="343" width="491" height="40" uuid="abcd0000-0000-0000-0000-000000000087"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>b)</b>&nbsp; The Borrower hereby irrevocably authorizes the Lender to debit its accounts at any time and without issuing a notice to the Borrower for whole or any part or parts of the amount outstanding under the financial facilities and any other amounts payable by the Borrower under the Loan Documents. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="385" width="491" height="64" uuid="abcd0000-0000-0000-0000-000000000088"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>c)</b>&nbsp; Notwithstanding anything contained in this Agreement, the Lender shall have a lien, irrespective of any other lien or charge over the deposits of any kind (including security deposits) held or balances lying in any account maintained by the Borrower and a right of set off against any monies due to the Lender from the Borrower and to combine all accounts of the Borrower for recovery of the Lender’s dues hereunder. The Lender’s rights hereunder shall not be affected by the Borrower’s bankruptcy, death or winding-up. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="451" width="491" height="76" uuid="abcd0000-0000-0000-0000-000000000089"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>d)</b>&nbsp; The Lender shall be absolutely entitled at any time, with notice to the Borrower, to combine all or any of the Borrower’s liabilities to or accounts with the Lender (whether alone or jointly or jointly with any other person) and set-off, transfer or apply any obligations of the Lender to the Borrower in or towards satisfaction of any obligations of the Borrower to the Lender, whether the obligations of the Borrower or Lender are actual or contingent, primary or collateral, several or joint, booked or payable at different branches (including branches outside India), or in different currencies. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="529" width="491" height="64" uuid="abcd0000-0000-0000-0000-000000000090"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>e)</b>&nbsp; It is hereby agreed and understood by the Borrower that, in the event of occurrence of an Event of Default or the Borrower defaulting in payment of the installments/charges/fees, without prejudice to the right of termination, the Lender shall have the right to set-off the amount in the Borrower’s account that it may be holding with the Lender with the amount in respect of which the default has been committed under this Agreement. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="595" width="491" height="64" uuid="abcd0000-0000-0000-0000-000000000091"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>f)</b>&nbsp; Notwithstanding the payment of any of the loan obligations under the Loan, the Borrower hereby expressly gives the Lender the power to appropriate proceeds out of any and all Security created in favour of the Lender under the Loan Documents or deposited with it or under its possession or control towards satisfaction of any amounts due to the Lender on account of another agreement or transaction entered into by the Borrower with the Lender. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="661" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000092"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>g)</b>&nbsp; For the avoidance of doubt, it is hereby clarified that these rights may additionally be exercised also upon the occurrence of Event of Default and/or breach of Agreement by the Borrower. "]]></textFieldExpression></textField><break><reportElement positionType="Float" x="0" y="691" width="535" height="1" uuid="abcd0000-0000-0000-0000-000000000093"/></break><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="692" width="513" height="28" uuid="abcd0000-0000-0000-0000-000000000094"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>6.11</b> All expenses towards creation and perfection of the Security including stamp duty, registration charges, etc. shall be borne by the Borrower(s).  "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="722" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000095"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>7.</b>&nbsp; <b>BORROWER’S REPRESENTATIONS, WARRANTIES, COVENANTS AND UNDERTAKINGS</b>   "]]></textFieldExpression></textField></band><band height="736" splitType="Stretch"><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="0" width="513" height="28" uuid="abcd0000-0000-0000-0000-000000000096"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>7.1</b> With a view to induce the Lender to grant the Loan, the Borrower(s), hereby represents/ warrants to/ covenants/ undertakes with the Lender that: "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="28" width="491" height="16" uuid="abcd0000-0000-0000-0000-000000000097"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>a)</b>&nbsp; Information furnished in the Application is true and complete in all respects; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="46" width="491" height="40" uuid="abcd0000-0000-0000-0000-000000000098"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>b)</b>&nbsp; All consents, approvals, clearances, permissions, authorizations or requirements required in connection with the execution and validity of this Agreement, other Loan Documents and for creation/perfection of Security in favour of the Lender have been obtained and are in full force and effect; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="88" width="491" height="40" uuid="abcd0000-0000-0000-0000-000000000099"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>c)</b>&nbsp; The Borrower(s) is a citizen of India and a major (in terms of age) and is of sound mind and is competent to contract and enter into and perform his/her obligations contemplated under this Agreement/other Loan Documents in respect of the Loan; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="130" width="491" height="52" uuid="abcd0000-0000-0000-0000-000000000100"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>d)</b>&nbsp; There has been no material adverse change in the financial position of the Borrower(s) nor has any event taken place which is prejudicial to the interest of the Lender which is likely to materially and/or adversely affect the ability of the Borrower(s) to perform all or any of its obligations under this Agreement and the other Loan Documents; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="184" width="491" height="16" uuid="abcd0000-0000-0000-0000-000000000101"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>e)</b>&nbsp; The Loan shall be utilised only for the Purpose. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="202" width="491" height="52" uuid="abcd0000-0000-0000-0000-000000000102"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>f)</b>&nbsp; The Borrower(s) shall, whenever required by the Lender, submit statements of annual income certified and audited by a practicing chartered accountant along with a copy of the tax returns filed with the income tax authorities duly certified by such chartered accountant and such other information/documents concerning employment, trade, business, profession or otherwise as the Lender may require from time to time; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="256" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000103"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>g)</b>&nbsp; Wherever applicable, the Borrower(s) shall inform the Lender of any likely change in his employment or about his/her superannuation/retirement or change of his/her address. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="286" width="491" height="40" uuid="abcd0000-0000-0000-0000-000000000104"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>h)</b>&nbsp; The Borrower(s) shall (in case of more than one borrower) be jointly and severally liable to repay the Loan, interest and all other sums due and payable under this Agreement and to observe its terms and conditions; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="328" width="491" height="76" uuid="abcd0000-0000-0000-0000-000000000105"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>i)</b>&nbsp; Wherever applicable, the Borrower(s) shall notify the Lender regarding the change in his/her/their status as a resident/non-resident Indian. In case of being a non-resident Indian/person of Indian origin, shall abide by and fulfill the provisions of the Foreign Exchange Management Act, 1999, as amended from time to time and all other applicable laws with respect to purchasing, retaining, using, selling immovable property in India and repatriating proceeds outside India and shall fully indemnify and keep indemnified the Lender in that behalf during the currency of the Loan; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="406" width="491" height="76" uuid="abcd0000-0000-0000-0000-000000000106"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>j)</b>&nbsp; <b>Anti-Money Laundering</b>: All the amounts including the amount of own contribution paid/payable in connection with the Security as well as the Security is/shall be through legitimate source and does not/shall not constitute an offence of money laundering under the Prevention of Money Laundering Act, 2002. The Borrower(s) shall not permit any of the Loan proceeds to be used to fund any form of violent political activity, terrorists or terrorist organizations, nor any money laundering process or scheme to disguise illegally obtained funds, nor any other criminal activity including arms sales, drug trafficking, robbery, fraud or racketeering. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="484" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000107"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>k)</b>&nbsp; The Borrower(s) undertakes to declare and disclose within 10 (ten) days from the date of change, any changes that may take place in the information provided to the Lender; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="514" width="491" height="52" uuid="abcd0000-0000-0000-0000-000000000108"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>l)</b>&nbsp; The Borrower(s) also agrees that failure to disclose any material fact known to the Borrower(s), now or in future, may invalidate the Borrower(s)’ Application and the Lender would be within its right to put restrictions in the operations of the Loan Account or close it at its sole discretion upon happening of any such event; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="568" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000109"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>m)</b>&nbsp; It shall be the responsibility of the Borrower(s) to educate himself and to comply at all times with all relevant laws relating to Foreign Account Tax Compliance Act (FATCA)/(CRS) reporting (if applicable); "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="598" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000110"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>n)</b>&nbsp; The Borrower(s) also agrees to furnish and intimate to the Lender, any other particulars that he/she is required to provide on account of any change in law either in India or abroad in the subject matter herein; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="628" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000111"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>o)</b>&nbsp; The Borrower(s) agrees to indemnify and hold harmless the Lender for any loss that may arise to the Lender on account of providing incorrect or incomplete information; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="658" width="491" height="40" uuid="abcd0000-0000-0000-0000-000000000112"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>p)</b>&nbsp; Except to the extent disclosed to the Lender: (a) the Borrower(s) is not a director or specified near relation of a director of a banking company, and (b) the Borrower(s) is not a specified near relation to any senior officer of the Lender. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="700" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000113"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>q)</b>&nbsp; The Borrower(s) has not been declared a willful defaulter and shall ensure that he/ she shall not be declared as a willful defaulter. "]]></textFieldExpression></textField></band><band height="706" splitType="Stretch"><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="0" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000114"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>r)</b>&nbsp; The Borrower(s) shall not, during the tenure of this Agreement, avail of or obtain any further loan or facility without the prior written consent of the Lender. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="30" width="491" height="52" uuid="abcd0000-0000-0000-0000-000000000115"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>s)</b>&nbsp; The Borrower(s) acknowledges and accepts the rates of interest and its calculation method, other fees, charges and all other amounts payable as per the terms of this Agreement as reasonable and the Borrower(s) has understood the meaning of each term and financial implications, amounts payable and liabilities and obligations created under this Agreement. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="84" width="491" height="40" uuid="abcd0000-0000-0000-0000-000000000116"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>t)</b>&nbsp; The obligation to deduct and deposit tax, if applicable, on purchase of immovable property under Section 194IA of the Income-tax Act, 1961 rests with the Borrower(s) and the Lender will not be liable to make such payments on behalf of the Borrower. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="126" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000117"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>u)</b>&nbsp; There are no pending claims, demands, litigation, or proceedings against the Borrower(s) before any court or authority. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="156" width="491" height="76" uuid="abcd0000-0000-0000-0000-000000000118"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>v)</b>&nbsp; Any security(ies) furnished by the Borrower(s), under any other agreement entered into or to be entered into with the Lender, shall be deemed to be the Security(ies) under this Agreement. Further, the Borrower(s) agree(s) that the Security(ies) offered in respect of this Loan shall be deemed to be continuing security(ies) in respect of other loan(s)/ facility(ies) obtained/ to be obtained by the Borrower(s) from the Lender and shall not be discharged till such time all the loan(s)/ facility(ies) are fully discharged to the satisfaction of the Lender. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="234" width="491" height="52" uuid="abcd0000-0000-0000-0000-000000000119"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>w)</b>&nbsp; The Borrower(s) shall, upon request of the Lender, allow the Lender and any nominee, servant, or agent of the Lender to inspect the Borrower(s)’ premises and plant and machinery, vehicles, and other assets and the Borrower(s)’ books of accounts for ensuring that the Borrower(s) has duly complied with the terms of the Loan. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="288" width="491" height="64" uuid="abcd0000-0000-0000-0000-000000000120"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>x)</b>&nbsp; All contents and terms and conditions of the Sanction Letter and the Loan Agreement, demand promissory note, loan documents, and the documents executed by the Borrower in favour of the Lender, including amount of loan sanctioned, annualized rate of interest, Key Facts Statement and method of application thereof, for the loan availed/ being availed by the Borrower has been read over and explained to the Borrower and the Borrower has understood the same as per the declaration (“<b>Schedule IV</b>”) provided by the Borrower. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="354" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000121"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>y)</b>&nbsp; The Borrower(s) is not in the business of, has not and shall not undertake any activities in the Prohibited List (“<b>Schedule V</b>”). "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="386" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000122"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>8.</b>&nbsp; <b>EVENTS OF DEFAULT AND CONSEQUENCES THEREOF</b>                                       "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="402" width="513" height="40" uuid="abcd0000-0000-0000-0000-000000000123"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>8.1</b> The Lender may by a written notice to the Borrower(s), declare all sums outstanding under the Loan (<i>including the principal, interest, charges, expenses</i>) to become due and payable forthwith and enforce the Security upon the occurrence (<i>in the sole decision of the Lender</i>) of any one or more of the following: "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="442" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000124"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>a)</b>&nbsp; The Borrower(s) fails to pay to the Lender EMI/ P-EMI/ any amount when due and payable under this Agreement; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="472" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000125"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>b)</b>&nbsp; The Borrower(s) fails to register NACH or if the NACH is dishonoured for any reason whatsoever upon presentation; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="502" width="491" height="40" uuid="abcd0000-0000-0000-0000-000000000126"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>c)</b>&nbsp; The Borrower(s) defaults in performing any of his/ her obligations under this Agreement or breaches any of the terms or conditions of this Agreement or any other Loan Documents, or other undertakings etc. executed in favour of the Lender; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="544" width="491" height="16" uuid="abcd0000-0000-0000-0000-000000000127"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>d)</b>&nbsp; If the Loan is used other than for Purpose; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="562" width="491" height="40" uuid="abcd0000-0000-0000-0000-000000000128"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>e)</b>&nbsp; The death, insolvency, failure in business, commission of an act of bankruptcy, general assignment for the benefit of creditors, if the Borrower(s) suspends payment to any creditors and/ or the Borrower(s) threatening to do so and/or the filing of any petition in bankruptcy of by, or against the Borrower(s); "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="604" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000129"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>f)</b>&nbsp; Any representation, warranty etc. made by the Borrower(s) herein being found to be or becoming incorrect or untrue; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="634" width="491" height="64" uuid="abcd0000-0000-0000-0000-000000000130"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>g)</b>&nbsp; If the Borrower(s) fails to create the Security as provided herein or if the Security is destroyed, sold, disposed of, charged, encumbered, alienated, attached or restrained in any manner or if the value of the Security or any Security created or tendered by the Borrower(s), in the sole discretion and decision of the Lender, depreciates entitling the Lender to call for further security and the Borrower(s) fails to give additional security; "]]></textFieldExpression></textField></band><band height="686" splitType="Stretch"><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="0" width="491" height="64" uuid="abcd0000-0000-0000-0000-000000000131"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>h)</b>&nbsp; If any consent, authorisation, approval or license of or registration with or declaration to governmental or public bodies or authorities required by the Borrower(s) in connection with the execution, delivery, validity, enforceability or admissibility in evidence of this Agreement or the performance by the Borrower(s) of its obligations hereunder is modified in a manner unacceptable to the Lender or is not granted or revoked or terminated or expires and is not renewed or otherwise ceases to be in full force and effect; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="66" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000132"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>i)</b>&nbsp; An event of default howsoever described occurs under any other agreement or document relating to any indebtedness of the Borrower(s) with the Lender or other lenders, if any. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="96" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000133"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>j)</b>&nbsp; Any other event likely to have materially adverse effect on the ability of the Borrower(s) to make payments under this Agreement. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="126" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000134"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>8.2</b> <b>Consequences of default</b>  "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="142" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000135"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" In the event of any default as mentioned in Clause 8.1 above the Lender shall have the right to:"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="158" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000136"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>I.</b>&nbsp; Cancel/recall the entire Loan and declare all monies outstanding under this Agreement to be due and immediately payable; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="188" width="491" height="40" uuid="abcd0000-0000-0000-0000-000000000137"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>II.</b>&nbsp; Take possession of the Security so created whether by itself or through any attorneys as may be appointed by the Lender and alienate, sell, transfer the same, in such manner as it may deem proper at its sole discretion; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="230" width="491" height="16" uuid="abcd0000-0000-0000-0000-000000000138"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>III.</b>&nbsp; Take any other action as it may deem fit for recovery of its dues and enforcement of the Security. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="248" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000139"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>8.3</b> <b>Appointment of the Lender as the Borrower’s attorney</b>  "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="264" width="513" height="64" uuid="abcd0000-0000-0000-0000-000000000140"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" The Borrower(s) hereby appoints the Lender as its true and lawful attorney, for the purpose of this Agreement and other Loan Documents, to do and execute for and in the name and on behalf of the Borrower(s) and where the Borrower(s) is more than one individual, jointly and severally, all or any of the acts, deeds and things, specified therein. The powers so vested in the Lender shall be irrevocable and subsist in favour of the Lender till all dues of the Borrower(s) to the Lender are fully satisfied. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="328" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000141"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>8.4</b> <b>Asset Classification</b>  "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="344" width="513" height="52" uuid="abcd0000-0000-0000-0000-000000000142"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" The Borrower(s) acknowledges that any delay or default in payment of any amount due and payable under the Loan might adversely affect the Borrower(s)’ credit score. The Borrower(s) further acknowledges that the Loan might be classified in the Lender’s books as a special mention account (“<b>SMA</b>”) if any amount due and payable thereunder is overdue. "]]></textFieldExpression></textField><break><reportElement positionType="Float" x="0" y="396" width="535" height="1" uuid="abcd0000-0000-0000-0000-000000000143"/></break><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="397" width="513" height="100" uuid="abcd0000-0000-0000-0000-000000000144"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" For example, if any principle, interest, or any other amount is scheduled to be paid on the 31st day of a given month (\"<b>Scheduled Date</b>\") and such amount is not fully paid on or before such day, then the relevant loan account will be classified as SMA-0 as of such day. If the overdue continues for more than 30 (thirty) days from the Scheduled Date up to 60 (sixty) days from the Scheduled Date, then the account will be classified as SMA-1. If the overdue continues for more than 60 (sixty) days from the Scheduled Date up to 90 (ninety) days from the Scheduled Date, then the account will be classified as SMA-2. If the overdue continues for more than 90 (ninety) days from the Scheduled Date, then the account will be classified as Non-Performing Asset (<b>NPA</b>). Once a loan is classified as NPA, it shall remain as such till the time all overdue amounts are paid."]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="497" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000145"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" Please refer the below illustration."]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="513" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000146"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <i>Illustration (subject to the guidelines issued by RBI from time to time):</i>"]]></textFieldExpression></textField><frame><reportElement positionType="Float" x="22" y="529" width="513" height="17" uuid="abcd0000-0000-0000-0000-000000000147"/><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement stretchType="ContainerHeight" x="0" y="0" width="513" height="17" uuid="abcd0000-0000-0000-0000-000000000148"/><box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2"><topPen lineWidth="0.75" lineColor="#000000"/><leftPen lineWidth="0.75" lineColor="#000000"/><bottomPen lineWidth="0.75" lineColor="#000000"/><rightPen lineWidth="0.75" lineColor="#000000"/></box><textElement textAlignment="Center" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="8" isBold="true"/></textElement><textFieldExpression><![CDATA["Scheduled Date: March 31, 2024"]]></textFieldExpression></textField></frame><frame><reportElement positionType="Float" x="22" y="546" width="513" height="17" uuid="abcd0000-0000-0000-0000-000000000149"/><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement stretchType="ContainerHeight" x="0" y="0" width="171" height="17" uuid="abcd0000-0000-0000-0000-000000000150"/><box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2"><topPen lineWidth="0.75" lineColor="#000000"/><leftPen lineWidth="0.75" lineColor="#000000"/><bottomPen lineWidth="0.75" lineColor="#000000"/><rightPen lineWidth="0.75" lineColor="#000000"/></box><textElement textAlignment="Center" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="8" isBold="true"/></textElement><textFieldExpression><![CDATA["Classification"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement stretchType="ContainerHeight" x="171" y="0" width="171" height="17" uuid="abcd0000-0000-0000-0000-000000000151"/><box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2"><topPen lineWidth="0.75" lineColor="#000000"/><leftPen lineWidth="0.75" lineColor="#000000"/><bottomPen lineWidth="0.75" lineColor="#000000"/><rightPen lineWidth="0.75" lineColor="#000000"/></box><textElement textAlignment="Center" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="8" isBold="true"/></textElement><textFieldExpression><![CDATA["Date of classification"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement stretchType="ContainerHeight" x="342" y="0" width="171" height="17" uuid="abcd0000-0000-0000-0000-000000000152"/><box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2"><topPen lineWidth="0.75" lineColor="#000000"/><leftPen lineWidth="0.75" lineColor="#000000"/><bottomPen lineWidth="0.75" lineColor="#000000"/><rightPen lineWidth="0.75" lineColor="#000000"/></box><textElement textAlignment="Center" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="8" isBold="true"/></textElement><textFieldExpression><![CDATA["Condition for classification"]]></textFieldExpression></textField></frame><frame><reportElement positionType="Float" x="22" y="563" width="513" height="37" uuid="abcd0000-0000-0000-0000-000000000153"/><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement stretchType="ContainerHeight" x="0" y="0" width="171" height="37" uuid="abcd0000-0000-0000-0000-000000000154"/><box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2"><topPen lineWidth="0.75" lineColor="#000000"/><leftPen lineWidth="0.75" lineColor="#000000"/><bottomPen lineWidth="0.75" lineColor="#000000"/><rightPen lineWidth="0.75" lineColor="#000000"/></box><textElement textAlignment="Left" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["SMA-0"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement stretchType="ContainerHeight" x="171" y="0" width="171" height="37" uuid="abcd0000-0000-0000-0000-000000000155"/><box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2"><topPen lineWidth="0.75" lineColor="#000000"/><leftPen lineWidth="0.75" lineColor="#000000"/><bottomPen lineWidth="0.75" lineColor="#000000"/><rightPen lineWidth="0.75" lineColor="#000000"/></box><textElement textAlignment="Left" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["Scheduled Date"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement stretchType="ContainerHeight" x="342" y="0" width="171" height="37" uuid="abcd0000-0000-0000-0000-000000000156"/><box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2"><topPen lineWidth="0.75" lineColor="#000000"/><leftPen lineWidth="0.75" lineColor="#000000"/><bottomPen lineWidth="0.75" lineColor="#000000"/><rightPen lineWidth="0.75" lineColor="#000000"/></box><textElement textAlignment="Left" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["If the amount(s) scheduled to be paid on the Scheduled Date is not paid on the Scheduled Date. "]]></textFieldExpression></textField></frame><frame><reportElement positionType="Float" x="22" y="600" width="513" height="26" uuid="abcd0000-0000-0000-0000-000000000157"/><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement stretchType="ContainerHeight" x="0" y="0" width="171" height="26" uuid="abcd0000-0000-0000-0000-000000000158"/><box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2"><topPen lineWidth="0.75" lineColor="#000000"/><leftPen lineWidth="0.75" lineColor="#000000"/><bottomPen lineWidth="0.75" lineColor="#000000"/><rightPen lineWidth="0.75" lineColor="#000000"/></box><textElement textAlignment="Left" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["SMA-1"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement stretchType="ContainerHeight" x="171" y="0" width="171" height="26" uuid="abcd0000-0000-0000-0000-000000000159"/><box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2"><topPen lineWidth="0.75" lineColor="#000000"/><leftPen lineWidth="0.75" lineColor="#000000"/><bottomPen lineWidth="0.75" lineColor="#000000"/><rightPen lineWidth="0.75" lineColor="#000000"/></box><textElement textAlignment="Left" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["April 30, 2024"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement stretchType="ContainerHeight" x="342" y="0" width="171" height="26" uuid="abcd0000-0000-0000-0000-000000000160"/><box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2"><topPen lineWidth="0.75" lineColor="#000000"/><leftPen lineWidth="0.75" lineColor="#000000"/><bottomPen lineWidth="0.75" lineColor="#000000"/><rightPen lineWidth="0.75" lineColor="#000000"/></box><textElement textAlignment="Left" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["If any amount remains overdue for more than 30 days from the Scheduled Date. "]]></textFieldExpression></textField></frame><frame><reportElement positionType="Float" x="22" y="626" width="513" height="26" uuid="abcd0000-0000-0000-0000-000000000161"/><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement stretchType="ContainerHeight" x="0" y="0" width="171" height="26" uuid="abcd0000-0000-0000-0000-000000000162"/><box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2"><topPen lineWidth="0.75" lineColor="#000000"/><leftPen lineWidth="0.75" lineColor="#000000"/><bottomPen lineWidth="0.75" lineColor="#000000"/><rightPen lineWidth="0.75" lineColor="#000000"/></box><textElement textAlignment="Left" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["SMA-2"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement stretchType="ContainerHeight" x="171" y="0" width="171" height="26" uuid="abcd0000-0000-0000-0000-000000000163"/><box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2"><topPen lineWidth="0.75" lineColor="#000000"/><leftPen lineWidth="0.75" lineColor="#000000"/><bottomPen lineWidth="0.75" lineColor="#000000"/><rightPen lineWidth="0.75" lineColor="#000000"/></box><textElement textAlignment="Left" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["May 30, 2024"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement stretchType="ContainerHeight" x="342" y="0" width="171" height="26" uuid="abcd0000-0000-0000-0000-000000000164"/><box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2"><topPen lineWidth="0.75" lineColor="#000000"/><leftPen lineWidth="0.75" lineColor="#000000"/><bottomPen lineWidth="0.75" lineColor="#000000"/><rightPen lineWidth="0.75" lineColor="#000000"/></box><textElement textAlignment="Left" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["If any amount remains overdue for more than 60 days from the Scheduled Date. "]]></textFieldExpression></textField></frame><frame><reportElement positionType="Float" x="22" y="652" width="513" height="26" uuid="abcd0000-0000-0000-0000-000000000165"/><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement stretchType="ContainerHeight" x="0" y="0" width="171" height="26" uuid="abcd0000-0000-0000-0000-000000000166"/><box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2"><topPen lineWidth="0.75" lineColor="#000000"/><leftPen lineWidth="0.75" lineColor="#000000"/><bottomPen lineWidth="0.75" lineColor="#000000"/><rightPen lineWidth="0.75" lineColor="#000000"/></box><textElement textAlignment="Left" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["NPA"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement stretchType="ContainerHeight" x="171" y="0" width="171" height="26" uuid="abcd0000-0000-0000-0000-000000000167"/><box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2"><topPen lineWidth="0.75" lineColor="#000000"/><leftPen lineWidth="0.75" lineColor="#000000"/><bottomPen lineWidth="0.75" lineColor="#000000"/><rightPen lineWidth="0.75" lineColor="#000000"/></box><textElement textAlignment="Left" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["June 29, 2024"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement stretchType="ContainerHeight" x="342" y="0" width="171" height="26" uuid="abcd0000-0000-0000-0000-000000000168"/><box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2"><topPen lineWidth="0.75" lineColor="#000000"/><leftPen lineWidth="0.75" lineColor="#000000"/><bottomPen lineWidth="0.75" lineColor="#000000"/><rightPen lineWidth="0.75" lineColor="#000000"/></box><textElement textAlignment="Left" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["If any amount remains overdue for more than 90 days from the Scheduled Date. "]]></textFieldExpression></textField></frame></band><band height="748" splitType="Stretch"><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="0" width="513" height="76" uuid="abcd0000-0000-0000-0000-000000000169"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" The Borrower(s) acknowledges that as per RBI guidelines, classification of accounts as NPA is done borrower wise and not facility wise and hence, it may be noted that in case of non-payment of dues by the Borrower(s) in case of any facility availed from the Lender and consequently the account is to be classified as NPA, all other loan accounts of the Borrower(s) with the Lender also shall be classified as NPA as per the guidelines issued by RBI and it shall entitle the Lender to recall all such loans/ facilities availed by the same customer from the Bank, irrespective of the regular repayment in such accounts."]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="76" width="513" height="40" uuid="abcd0000-0000-0000-0000-000000000170"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" The Borrower(s) may also refer to the consumer education literature available on our website (www.sarvagram.com), explaining with examples, the concepts of date of overdue, SMA and NPA classification and upgradation, with specific reference to day-end process."]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="116" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000171"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>8.5</b> <b>Recovery Agents</b>  "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="132" width="513" height="40" uuid="abcd0000-0000-0000-0000-000000000172"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" The Lender does not involve or outsource the collection of any outstanding amounts under this Agreement and any other agreement to any third-party recovery agent, agency, or entity (\"Recovery Agent\"). The collection of any outstanding amounts under this Agreement and any other agreement are done by the employees of the Lender."]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="172" width="513" height="40" uuid="abcd0000-0000-0000-0000-000000000173"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" The Lender shall communicate directly with the Borrower(s) regarding any matters related to the collection of outstanding amounts, including but not limited to repayment schedules, default notices, and negotiation of repayment terms."]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="212" width="513" height="52" uuid="abcd0000-0000-0000-0000-000000000174"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" The Lender shall ensure that all communication and collection activities conducted directly by the Lender or its authorized representatives are carried out in a fair, transparent, and respectful manner, in compliance with applicable laws and regulations. Please refer to the collection and recovery policy of the Lender available on its website."]]></textFieldExpression></textField><break><reportElement positionType="Float" x="0" y="264" width="535" height="1" uuid="abcd0000-0000-0000-0000-000000000175"/></break><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="265" width="513" height="28" uuid="abcd0000-0000-0000-0000-000000000176"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" The Lender may utilize the services of recovery agents for collection of dues and repossession of securities, as and when required."]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="293" width="513" height="28" uuid="abcd0000-0000-0000-0000-000000000177"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" Recovery agents, if utilized, will be appointed as per regulatory guidelines issued in this regard. In this respect:"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="321" width="491" height="16" uuid="abcd0000-0000-0000-0000-000000000178"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>a)</b>&nbsp; Only recovery agents from the empaneled vendors will be engaged by the Lender. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="339" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000179"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>b)</b>&nbsp; In case the Lender engages service of such recovery/ enforcement/ seizure agent for any recovery case, the identity of the agent will be disclosed and proper communication will be sent to the Borrower(s); and "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="369" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000180"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>c)</b>&nbsp; The recovery agents engaged by the Lender will be required to follow a code of conduct covering their dealings with customers and in compliance with collection and recovery policy of the Lender. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="401" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000181"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>9.</b>&nbsp; <b>ASSIGNMENT AND TRANSFER</b>     "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="417" width="513" height="88" uuid="abcd0000-0000-0000-0000-000000000182"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" The Lender shall have a right to sell or transfer (by way of assignment, securitisation or otherwise) whole or part of the Loan and outstanding amounts under the Loan or any other rights or obligations under this Agreement or any other document pursuant hereto to any person in a manner or under such terms and conditions as the Lender may decide in its sole discretion including reserving a right to the Lender to retain its power hereunder to proceed against the Borrower(s) on behalf of the purchaser, assignee or transferee, any or all outstanding and dues of the Borrower(s), to any third party of the Lender’s choice without reference to or without intimation to the Borrower(s). "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="505" width="513" height="28" uuid="abcd0000-0000-0000-0000-000000000183"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" The Borrower shall not transfer or assign the rights under this Agreement without previous written consent of the Lender."]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="535" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000184"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>10.</b>&nbsp; <b>DISCLOSURE/ SHARING OF INFORMATION</b>      "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="551" width="513" height="124" uuid="abcd0000-0000-0000-0000-000000000185"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>10.1</b> The Borrower(s) irrevocably agrees and consents to the Lender at any time and in any manner disclosing and/or making available to any agencies, bureaus, affiliates or subsidiaries of the Lender, associations and other persons whosoever any information (including personal and financial information) and documents of or relating to the Borrower(s), including any credit information, in such cases where the Lender considers appropriate including where such disclosure is permitted or required by or under law or where the Lender is of the view that the interests of the Lender require such disclosure or for furnishing such information and documents for preparation, publication and distribution of credit reports and credit opinions relating to the Borrower(s) to other persons including banks and financial institutions. The provisions of this clause shall survive termination of this Agreement. The Lender shall also have a right to obtain similar information/reports relating to the Borrower(s) from credit agencies, credit bureaus, other banks and financial institutions as the Lender may deem fit.  "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="675" width="513" height="64" uuid="abcd0000-0000-0000-0000-000000000186"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>10.2</b> The Borrower(s) agrees that if the Borrower(s) commits any breach of any provision of this Agreement or any default or delay in the repayment of the Loan or any amount payable under this Agreement whatsoever which the Borrower(s) is liable to pay, the Lender shall have the unqualified right to disclose or publish the Borrower(s)’ name and particulars (including photographs and particulars of accounts), as a defaulter in such manner as the Lender may deem fit.  "]]></textFieldExpression></textField><break><reportElement positionType="Float" x="0" y="739" width="535" height="1" uuid="abcd0000-0000-0000-0000-000000000187"/></break></band><band height="741" splitType="Stretch"><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="0" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000188"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>10.3</b> The Borrower(s) understands that:  "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="16" width="491" height="28" uuid="abcd0000-0000-0000-0000-000000000189"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>a)</b>&nbsp; the TransUnion CIBIL Limited and any other agency so authorized may use, process the said information and data disclosed by the Lender in the manner as deemed fit by them; and "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="44" y="46" width="491" height="40" uuid="abcd0000-0000-0000-0000-000000000190"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>b)</b>&nbsp; the TransUnion CIBIL Limited and any other agency so authorized may furnish for consideration, the processed information and data or products thereof prepared by them, to banks/financial institutions and other credit grantors or registered users, as may be specified by RBI in this behalf. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="90" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000191"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>11.</b>&nbsp; <b>LOAN PROTECTION/ INSURANCE</b>    "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="106" width="513" height="88" uuid="abcd0000-0000-0000-0000-000000000192"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>11.1</b> The Borrower(s) shall procure such loan protection insurance from insurance service provider, as may be acceptable to the Lender, in order to protect the Borrower(s) against any risk of payment incapacities in case of critical illness/ disability/ death/ job loss, as per the scope of the insurance policy. The premium of such Insurance, if opted, may be paid either separately by the Borrower(s) or may be included in the Loan. Any cancellation of such insurance may be permitted during the tenor of the Loan, as defined in the scope of the insurance policy. Such insurance shall be assigned to the Lender in a form and manner satisfactory to the Lender. The Lender shall be mentioned as the FIRST loss payee under the insurance policy.  "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="194" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000193"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>11.2</b> Insurance is non-mandatory and offered only to customers who voluntarily choose to opt for the same.  "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="210" width="513" height="28" uuid="abcd0000-0000-0000-0000-000000000194"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>11.3</b> In case the Loan is cancelled, the insurance policy will also get cancelled automatically and the certificate of insurance (if received/issued) will remain cancelled/revoked.  "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="240" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000195"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>12.</b>&nbsp; <b>MISCELLANEOUS</b>  "]]></textFieldExpression></textField><break><reportElement positionType="Float" x="0" y="258" width="535" height="1" uuid="abcd0000-0000-0000-0000-000000000196"/></break><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="259" width="535" height="28" uuid="abcd0000-0000-0000-0000-000000000197"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>IN WITNESS WHEREOF </b> the Parties hereto have executed these presents on the day, month and year mentioned in the Schedule."]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="287" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000198"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <br/> "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="303" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000199"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" Name &amp; Signature of the Borrower: " + ($P{applicantName}==null?"":String.valueOf($P{applicantName}))]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="319" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000200"/><textElement