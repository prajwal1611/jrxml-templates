<font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>SCHEDULE II</b>"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="682" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000578"/><textElement textAlignment="Center" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>DEMAND PROMISSORY NOTE</b>"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="698" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000579"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" Date:" + ($P{date}==null?"":String.valueOf($P{date})) + " <br/> Place: " + ($P{branchName}==null?"":String.valueOf($P{branchName})) + " <br/> <br/> "]]></textFieldExpression></textField></band><band height="742" splitType="Stretch"><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="0" width="535" height="88" uuid="abcd0000-0000-0000-0000-000000000580"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" ON DEMAND, for value received, I/ We <u> " + ($P{applicantName}==null?"":String.valueOf($P{applicantName})) + "  " + "" + "  </u> does hereby jointly and/or severally, irrevocably and unconditionally promise to pay to Sarvagram Fincare Private Limited (“the Lender” including, its successors and assigns), having its registered office at Office No. 22, 4th Floor, Primrose Mall, Baner Road, Baner Gaon, Haveli, Pune - 411045, Maharashtra and having a branch office at " + ($P{branchName}==null?"":String.valueOf($P{branchName})) + " to the order the sum of INR " + ($P{amount}==null?"":String.valueOf($P{amount})) + "/- (Indian Rupees " + ($P{amountText}==null?"":String.valueOf($P{amountText})) + " only) together with interest thereon, at the rate of " + ($P{roi}==null?"":String.valueOf($P{roi})) + " per annum pursuant to the loan agreement executed with the Lender, payable with monthly interests, for value received along with any charges imposed by the Lender. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="88" width="535" height="28" uuid="abcd0000-0000-0000-0000-000000000581"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" Presentment for payment, noting and any type of demur or protest of the note are hereby unconditionally and irrevocably waived."]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="116" width="535" height="28" uuid="abcd0000-0000-0000-0000-000000000582"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" This Demand Promissory Note forms a part of the Loan Documents and is governed by and construed in accordance with Indian Laws."]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="144" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000583"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" Name of Borrower: " + ($P{applicantName}==null?"":String.valueOf($P{applicantName})) + " "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="160" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000584"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["  Affix Rs 1/- Revenue<br/> Stamp here Borrower  "]]></textFieldExpression></textField><componentElement><reportElement positionType="Float" x="0" y="176" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000586"/><jr:list xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd" printOrder="Vertical"><datasetRun subDataset="CoApplicantNameDataset" uuid="abcd0000-0000-0000-0000-000000000587"><dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($P{coApplicantList}==null?new java.util.ArrayList():$P{coApplicantList})]]></dataSourceExpression></datasetRun><jr:listContents height="16" width="535"><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="0" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000585"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" Name of Co-Borrower: " + ($F{_THIS}==null?"":String.valueOf($F{_THIS})) + "<br/> "]]></textFieldExpression></textField></jr:listContents></jr:list></componentElement><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="192" width="535" height="16" uuid="abcd0000-0000-