"0" width="267" height="17" uuid="abcd0000-0000-0000-0000-000000000624"/><box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2"><topPen lineWidth="0.75" lineColor="#000000"/><leftPen lineWidth="0.75" lineColor="#000000"/><bottomPen lineWidth="0.75" lineColor="#000000"/><rightPen lineWidth="0.75" lineColor="#000000"/></box><textElement textAlignment="Left" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["MICR Code:"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement stretchType="ContainerHeight" x="267" y="0" width="268" height="17" uuid="abcd0000-0000-0000-0000-000000000625"/><box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2"><topPen lineWidth="0.75" lineColor="#000000"/><leftPen lineWidth="0.75" lineColor="#000000"/><bottomPen lineWidth="0.75" lineColor="#000000"/><rightPen lineWidth="0.75" lineColor="#000000"/></box><textElement textAlignment="Left" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA[($P{micrCode}==null?"":String.valueOf($P{micrCode}))]]></textFieldExpression></textField></frame><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="558" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000626"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>Terms &amp; conditions:</b>"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="574" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000627"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>1.</b>&nbsp; I authorize the Lender to carry out the fund transfer transaction as per details mentioned above. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="592" width="513" height="28" uuid="abcd0000-0000-0000-0000-000000000628"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>2.</b>&nbsp; I hereby undertake that the aforesaid details including IFSC Code and beneficiary account number are correct. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="622" width="513" height="28" uuid="abcd0000-0000-0000-0000-000000000629"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>3.</b>&nbsp; I further acknowledge and agree that the Lender shall not be liable in any event for any consequences arising out of any erroneous details provided by me or any such other event as may be out of control of the Lender. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="652" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000630"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>4.</b>&nbsp; NEFT/RTGS request is subject to RBI guidelines. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="670" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000631"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" Name of the Borrower &amp; Co-Borrower: " + ($P{applicantName}==null?"":String.valueOf($P{applicantName})) + " "]]></textFieldExpression></textField><componentElement><reportElement positionType="Float" x="0" y="686" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000633"/><jr:list xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd" printOrder="Vertical"><datasetRun subDataset="CoApplicantNameDataset" uuid="abcd0000-0000-0000-0000-000000000634"><dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($P{coApplicantList}==null?new java.util.ArrayList():$P{coApplicantList})]]></dataSourceExpression></datasetRun><jr:listContents height="16" width="535"><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="0" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000632"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["Co-Borrower:" + ($F{_THIS}==null?"":String.valueOf($F{_THIS})) + " "]]></textFieldExpression></textField></jr:listContents></jr:list></componentElement><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="702" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000635"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["Borrower"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="718" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000636"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["Co-Borrower"]]></textFieldExpression></textField></band><band height="734" splitType="Stretch"><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="0" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000637"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["For SFPL Authorised Signatory "]]></textFieldExpression></textField><break><reportElement positionType="Float" x="0" y="16" width="535" height="1" uuid="abcd0000-0000-0000-0000-000000000638"/></break><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="17" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000639"/><textElement textAlignment="Center" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>SCHEDULE IV</b>"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="33" width="535" height="28" uuid="abcd0000-0000-0000-0000-000000000640"/><textElement textAlignment="Center" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>DECLARATION IN CASE THE BORROWER/ CO-BORROWER IS ILLITERATE OR IS BLIND OR EXECUTES LOAN DOCUEMNTS IN VERNACULAR LANGUAGE</b>"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="61" width="535" height="52" uuid="abcd0000-0000-0000-0000-000000000641"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" I/ We, refer to the sanction letter dated " + ($P{sanctionDate}==null?"":String.valueOf($P{sanctionDate})) + " (“<b>Sanction Letter</b>”) and the loan agreement dated " + ($P{date}==null?"":String.valueOf($P{date})) + " (“<b>Loan Agreement</b>”) vide which I/ we have been sanctioned " + ($P{loanType}==null?"":String.valueOf($P{loanType})) + " loan of INR " + ($P{amount}==null?"":String.valueOf($P{amount})) + " (Indian Rupees " + ($P{amountText}==null?"":String.valueOf($P{amountText})) + ") by Sarvagram Fincare Private Limited as per the terms and conditions of the said Sanction Letter read with the said Loan Agreement."]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="113" width="535" height="88" uuid="abcd0000-0000-0000-0000-000000000642"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" I/ We hereby declare and confirm that as I/ we am/are [illiterate/ not literate in English/ blind], all contents and terms and conditions of the Sanction Letter and the Loan Agreement, demand promissory note, loan documents and the documents executed by me/us in favour of Sarvagram Fincare Private Limited (“<b>Lender</b>”), including amount of loan sanctioned, annualized rate of interest, Key Facts Statement and method of application thereof, for the loan availed/ being availed by me/ us has been read over and explained to me by Mr./ Ms. <u>________________</u> in " + ($P{language}==null?"":String.valueOf($P{language})) + " language who has countersigned this undertaking/ declaration and I/ we have executed/ put my/our right thumb impression on the same after fully understanding the terms and conditions mentioned therein."]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="201" width="535" height="40" uuid="abcd0000-0000-0000-0000-000000000643"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" I/ We hereby further declare and confirm that all the terms and conditions of the Sanction Letter of the said loan and the loan documents and all other documents stipulated by the Lender shall be binding on me/ us until the clearance of the liabilities under the said loan."]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="241" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000644"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" Name of the Borrower/ Co-Borrower: " + ($P{applicantName}==null?"":String.valueOf($P{applicantName})) + " / "]]></textFieldExpression></textField><componentElement><reportElement positionType="Float" x="0" y="257" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000646"/><jr:list xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd" printOrder="Vertical"><datasetRun subDataset="CoApplicantNameDataset" uuid="abcd0000-0000-0000-0000-000000000647"><dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($P{coApplicantList}==null?new java.util.ArrayList():$P{coApplicantList})]]></dataSourceExpression></datasetRun><jr:listContents height="16" width="535"><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="0" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000645"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" Co-Borrower:" + ($F{_THIS}==null?"":String.valueOf($F{_THIS})) + " "]]></textFieldExpression></textField></jr:listContents></jr:list></componentElement><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="273" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000648"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" __________________________ <br/> Signature: "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="289" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000649"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" Or"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="305" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000650"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" Right Thumb Impression of Borrower/Co-Borrower"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="321" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000651"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" ________________________ <br/> Name &amp; Signature "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="337" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000652"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" (SFPL employee who has explained terms of all <br/> loan documents to Borrower/Co-Borrower)"]]></textFieldExpression></textField><break><reportElement positionType="Float" x="0" y="353" width="535" height="1" uuid="abcd0000-0000-0000-0000-000000000653"/></break><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="354" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000654"/><textElement textAlignment="Center" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>SCHEDULE V</b>"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="0" y="370" width="535" height="16" uuid="abcd0000-0000-0000-0000-000000000655"/><textElement textAlignment="Center" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[" <b>PROHIBITED LISTS</b>"]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="386" width="513" height="40" uuid="abcd0000-0000-0000-0000-000000000656"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>1.</b>&nbsp; Activities involving harmful or exploitative forms of forced labor and/or harmful child labor, discrimination practices, or practices which prevent employees from exercising their legal rights of association and collective bargaining; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="428" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000657"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>2.</b>&nbsp; Manufacture and marketing of banned drugs; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="446" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000658"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>3.</b>&nbsp; Dealing in narcotics; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="464" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000659"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>4.</b>&nbsp; Racist and/or anti-democratic media; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="482" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000660"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>5.</b>&nbsp; Dealing in banned wildlife related products; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="500" width="513" height="28" uuid="abcd0000-0000-0000-0000-000000000661"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>6.</b>&nbsp; Polluting industries unless the units have clearance from pollution control authorities and have installed effluent treatment plants; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="530" width="513" height="64" uuid="abcd0000-0000-0000-0000-000000000662"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>7.</b>&nbsp; The production, storage, trade and transportation of fossil or nuclear fuels or radioactive materials and the production of power from these sources (provided that, for the avoidance of doubt, there is no prohibition from investing in entities whose business involves (a) batteries in relation to electric vehicles; (b) medical equipment, quality control (measurement) equipment and any equipment where the radioactive source is trivial and/or adequately shielded. "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="596" width="513" height="40" uuid="abcd0000-0000-0000-0000-000000000663"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>8.</b>&nbsp; The production of materials and other activities focused on (a) the consumption of tobacco or tobacco related products including e-cigarettes, or (b) pornography, or (c) prostitution or (d) gambling, gaming casinos and equivalent enterprises; or (e) alcoholic beverages; or (f) any cultivation of genetically modified organisms (GMOs); "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="638" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000664"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>9.</b>&nbsp; Production or trade in any product or activity deemed illegal under Indian laws or regulations; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="656" width="513" height="28" uuid="abcd0000-0000-0000-0000-000000000665"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>10.</b>&nbsp; The development, production, maintenance, trade or stock-piling of weapons of mass destruction, including ammunitions, radiological, nuclear, biological and chemical weapons; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="686" width="513" height="40" uuid="abcd0000-0000-0000-0000-000000000666"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>11.</b>&nbsp; The production of, or trade in, weapons or other munitions or of munitions-related components of a weapon, such as sub-munitions, fuses and warheads, or the provision of services to the military related to weapons or the use thereof; "]]></textFieldExpression></textField></band><band height="270" splitType="Stretch"><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="0" width="513" height="28" uuid="abcd0000-0000-0000-0000-000000000667"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>12.</b>&nbsp; Commercial logging operations or the purchase of logging equipment for use in primary tropical forests or old-growth forests; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="30" width="513" height="28" uuid="abcd0000-0000-0000-0000-000000000668"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>13.</b>&nbsp; Marine and coastal fishing practices, such as large-scale pelagic drift net fishing and fine mesh net fishing, harmful to vulnerable and protected species in large numbers and damaging to marine biodiversity and habitats; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="60" width="513" height="28" uuid="abcd0000-0000-0000-0000-000000000669"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>14.</b>&nbsp; Cross border trade in waste and waste products, unless compliant with the Basel Convention and the underlying regulations; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="90" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000670"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>15.</b>&nbsp; Production or trade in radioactive materials and unbonded asbestos fibres; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="108" width="513" height="16" uuid="abcd0000-0000-0000-0000-000000000671"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>16.</b>&nbsp; The operation of fur farms and the distribution of fur from farms or endangered species; "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="126" width="513" height="76" uuid="abcd0000-0000-0000-0000-000000000672"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>17.</b>&nbsp; Production of, or trade in, any product or activity deemed illegal under applicable law or national laws (including regulations) or subject to internationally agreed phase out or bans as defined in global conventions, agreements and treaties such as (a) certain hazardous chemicals, pharmaceuticals, ozone depleting substances, pesticides and wastes, (b) endangered or protected wildlife or wildlife products; and (c) unsustainable fishing methods such as blast fishing and drift net fishing in the marine environment using nets in excess of 2.5 kilometers in length; and "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="204" width="513" height="28" uuid="abcd0000-0000-0000-0000-000000000673"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>18.</b>&nbsp; Any activity which may result in funding or supporting any individual or organization designated as: (i) terrorists or terrorist organizations by India, the United Nations, the European Union; and "]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement positionType="Float" x="22" y="234" width="513" height="28" uuid="abcd0000-0000-0000-0000-000000000674"/><textElement textAlignment="Justified" verticalAlignment="Top" markup="html"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["<b>19.</b>&nbsp; Any other applicable country; and (ii) persons, groups or entities which are subject to Indian, United Nations, European Union and the US Office of Foreign Asset Control (OFAC) sanction. "]]></textFieldExpression></textField></band></detail>
</jasperReport>
