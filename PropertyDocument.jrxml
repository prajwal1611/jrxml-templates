<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="PropertyDocument"
              pageWidth="595" pageHeight="842"
              columnWidth="515"
              leftMargin="40" rightMargin="40"
              topMargin="40" bottomMargin="40"
              uuid="aa000000-0000-0000-0000-000000000001">

    <property name="net.sf.jasperreports.default.pdf.encoding" value="Identity-H"/>
    <property name="net.sf.jasperreports.default.pdf.embedded" value="true"/>

    <!-- =================== Sub dataset for the documents table =================== -->
    <subDataset name="DocumentDataset" uuid="aa000000-0000-0000-0000-000000000002">
        <field name="docName" class="java.lang.String"/>
        <field name="type" class="java.lang.String"/>
        <field name="description" class="java.lang.String"/>
        <field name="docNumber" class="java.lang.String"/>
        <field name="date" class="java.lang.String"/>
    </subDataset>

    <!-- =================== Parameters (mapped from LODDocumentDTO) =================== -->
    <parameter name="date" class="java.lang.String"/>
    <parameter name="lan" class="java.lang.String"/>
    <parameter name="applicantName" class="java.lang.String"/>
    <parameter name="branchName" class="java.lang.String"/>
    <parameter name="officeAddress" class="java.lang.String"/>
    <parameter name="productName" class="java.lang.String"/>
    <parameter name="leadId" class="java.lang.String"/>
    <parameter name="propertyList" class="java.util.List"/>
    <parameter name="documentList" class="java.util.List"/>

    <detail>
        <band height="640" splitType="Stretch">

            <!-- =================== Header info block =================== -->
            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement positionType="Float" x="0" y="0" width="515" height="16" uuid="aa000000-0000-0000-0000-000000000010"/>
                <textElement textAlignment="Left" verticalAlignment="Top">
                    <font fontName="SansSerif" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA["Date: " + ($P{date} == null ? "" : $P{date})]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement positionType="Float" x="0" y="18" width="515" height="16" uuid="aa000000-0000-0000-0000-000000000011"/>
                <textElement textAlignment="Left" verticalAlignment="Top">
                    <font fontName="SansSerif" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA["Loan Account No: " + ($P{lan} == null ? "" : $P{lan})]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement positionType="Float" x="0" y="36" width="515" height="16" uuid="aa000000-0000-0000-0000-000000000012"/>
                <textElement textAlignment="Left" verticalAlignment="Top">
                    <font fontName="SansSerif" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA["Customer Name: " + ($P{applicantName} == null ? "" : $P{applicantName})]]></textFieldExpression>
            </textField>

            <!-- Property addresses (numbered) -->
            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement positionType="Float" x="0" y="54" width="515" height="16" uuid="aa000000-0000-0000-0000-000000000013"/>
                <textElement textAlignment="Left" verticalAlignment="Top" markup="none">
                    <font fontName="SansSerif" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[($P{propertyList} == null || $P{propertyList}.isEmpty()) ? "" :
                    java.util.stream.IntStream.range(0, $P{propertyList}.size())
                        .mapToObj(i -> "Property " + (i + 1) + " - Address: " + String.valueOf($P{propertyList}.get(i)))
                        .collect(java.util.stream.Collectors.joining("\n"))]]></textFieldExpression>
            </textField>

            <!-- =================== Acknowledgement paragraph =================== -->
            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement positionType="Float" x="0" y="82" width="515" height="40" uuid="aa000000-0000-0000-0000-000000000020"/>
                <textElement textAlignment="Justified" verticalAlignment="Top" markup="html">
                    <font fontName="SansSerif" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA["Dear Sir / Madam<br/>We hereby acknowledge the receipt of documents, details of which are given below in connection with the " + ($P{productName} == null ? "" : $P{productName}) + " sanction to you."]]></textFieldExpression>
            </textField>

            <!-- =================== Documents table : header row =================== -->
            <frame>
                <reportElement positionType="Float" x="0" y="132" width="515" height="22" uuid="aa000000-0000-0000-0000-000000000030"/>
                <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                    <reportElement stretchType="ContainerHeight" x="0" y="0" width="40" height="22" uuid="aa000000-0000-0000-0000-000000000031"/>
                    <box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3">
                        <topPen lineWidth="0.75" lineColor="#000000"/>
                        <leftPen lineWidth="0.75" lineColor="#000000"/>
                        <bottomPen lineWidth="0.75" lineColor="#000000"/>
                        <rightPen lineWidth="0.75" lineColor="#000000"/>
                    </box>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font fontName="SansSerif" size="9" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Sr No."]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                    <reportElement stretchType="ContainerHeight" x="40" y="0" width="120" height="22" uuid="aa000000-0000-0000-0000-000000000032"/>
                    <box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3">
                        <topPen lineWidth="0.75" lineColor="#000000"/>
                        <bottomPen lineWidth="0.75" lineColor="#000000"/>
                        <rightPen lineWidth="0.75" lineColor="#000000"/>
                    </box>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font fontName="SansSerif" size="9" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Name"]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                    <reportElement stretchType="ContainerHeight" x="160" y="0" width="70" height="22" uuid="aa000000-0000-0000-0000-000000000033"/>
                    <box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3">
                        <topPen lineWidth="0.75" lineColor="#000000"/>
                        <bottomPen lineWidth="0.75" lineColor="#000000"/>
                        <rightPen lineWidth="0.75" lineColor="#000000"/>
                    </box>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font fontName="SansSerif" size="9" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Type"]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                    <reportElement stretchType="ContainerHeight" x="230" y="0" width="140" height="22" uuid="aa000000-0000-0000-0000-000000000034"/>
                    <box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3">
                        <topPen lineWidth="0.75" lineColor="#000000"/>
                        <bottomPen lineWidth="0.75" lineColor="#000000"/>
                        <rightPen lineWidth="0.75" lineColor="#000000"/>
                    </box>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font fontName="SansSerif" size="9" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Description"]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                    <reportElement stretchType="ContainerHeight" x="370" y="0" width="85" height="22" uuid="aa000000-0000-0000-0000-000000000035"/>
                    <box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3">
                        <topPen lineWidth="0.75" lineColor="#000000"/>
                        <bottomPen lineWidth="0.75" lineColor="#000000"/>
                        <rightPen lineWidth="0.75" lineColor="#000000"/>
                    </box>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font fontName="SansSerif" size="9" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Number"]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                    <reportElement stretchType="ContainerHeight" x="455" y="0" width="60" height="22" uuid="aa000000-0000-0000-0000-000000000036"/>
                    <box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3">
                        <topPen lineWidth="0.75" lineColor="#000000"/>
                        <bottomPen lineWidth="0.75" lineColor="#000000"/>
                        <rightPen lineWidth="0.75" lineColor="#000000"/>
                    </box>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font fontName="SansSerif" size="9" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Date"]]></textFieldExpression>
                </textField>
            </frame>

            <!-- =================== Documents table : dynamic rows =================== -->
            <componentElement>
                <reportElement positionType="Float" x="0" y="154" width="515" height="22" uuid="aa000000-0000-0000-0000-000000000040"/>
                <jr:list xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components"
                         xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd"
                         printOrder="Vertical">
                    <datasetRun subDataset="DocumentDataset" uuid="aa000000-0000-0000-0000-000000000041">
                        <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($P{documentList} == null ? new java.util.ArrayList() : $P{documentList})]]></dataSourceExpression>
                    </datasetRun>
                    <jr:listContents height="22" width="515">
                        <frame>
                            <reportElement stretchType="ContainerHeight" x="0" y="0" width="515" height="22" uuid="aa000000-0000-0000-0000-000000000042"/>
                            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                                <reportElement stretchType="ContainerHeight" x="0" y="0" width="40" height="22" uuid="aa000000-0000-0000-0000-000000000043"/>
                                <box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2">
                                    <leftPen lineWidth="0.75" lineColor="#000000"/>
                                    <bottomPen lineWidth="0.75" lineColor="#000000"/>
                                    <rightPen lineWidth="0.75" lineColor="#000000"/>
                                </box>
                                <textElement textAlignment="Center" verticalAlignment="Top">
                                    <font fontName="SansSerif" size="9"/>
                                </textElement>
                                <textFieldExpression><![CDATA[String.valueOf($V{REPORT_COUNT})]]></textFieldExpression>
                            </textField>
                            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                                <reportElement stretchType="ContainerHeight" x="40" y="0" width="120" height="22" uuid="aa000000-0000-0000-0000-000000000044"/>
                                <box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2">
                                    <bottomPen lineWidth="0.75" lineColor="#000000"/>
                                    <rightPen lineWidth="0.75" lineColor="#000000"/>
                                </box>
                                <textElement textAlignment="Left" verticalAlignment="Top">
                                    <font fontName="SansSerif" size="9"/>
                                </textElement>
                                <textFieldExpression><![CDATA[$F{docName}]]></textFieldExpression>
                            </textField>
                            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                                <reportElement stretchType="ContainerHeight" x="160" y="0" width="70" height="22" uuid="aa000000-0000-0000-0000-000000000045"/>
                                <box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2">
                                    <bottomPen lineWidth="0.75" lineColor="#000000"/>
                                    <rightPen lineWidth="0.75" lineColor="#000000"/>
                                </box>
                                <textElement textAlignment="Left" verticalAlignment="Top">
                                    <font fontName="SansSerif" size="9"/>
                                </textElement>
                                <textFieldExpression><![CDATA[$F{type}]]></textFieldExpression>
                            </textField>
                            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                                <reportElement stretchType="ContainerHeight" x="230" y="0" width="140" height="22" uuid="aa000000-0000-0000-0000-000000000046"/>
                                <box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2">
                                    <bottomPen lineWidth="0.75" lineColor="#000000"/>
                                    <rightPen lineWidth="0.75" lineColor="#000000"/>
                                </box>
                                <textElement textAlignment="Left" verticalAlignment="Top">
                                    <font fontName="SansSerif" size="9"/>
                                </textElement>
                                <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
                            </textField>
                            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                                <reportElement stretchType="ContainerHeight" x="370" y="0" width="85" height="22" uuid="aa000000-0000-0000-0000-000000000047"/>
                                <box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2">
                                    <bottomPen lineWidth="0.75" lineColor="#000000"/>
                                    <rightPen lineWidth="0.75" lineColor="#000000"/>
                                </box>
                                <textElement textAlignment="Left" verticalAlignment="Top">
                                    <font fontName="SansSerif" size="9"/>
                                </textElement>
                                <textFieldExpression><![CDATA[$F{docNumber}]]></textFieldExpression>
                            </textField>
                            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                                <reportElement stretchType="ContainerHeight" x="455" y="0" width="60" height="22" uuid="aa000000-0000-0000-0000-000000000048"/>
                                <box leftPadding="3" rightPadding="3" topPadding="2" bottomPadding="2">
                                    <bottomPen lineWidth="0.75" lineColor="#000000"/>
                                    <rightPen lineWidth="0.75" lineColor="#000000"/>
                                </box>
                                <textElement textAlignment="Left" verticalAlignment="Top">
                                    <font fontName="SansSerif" size="9"/>
                                </textElement>
                                <textFieldExpression><![CDATA[$F{date}]]></textFieldExpression>
                            </textField>
                        </frame>
                    </jr:listContents>
                </jr:list>
            </componentElement>

            <!-- =================== Applicant signature block =================== -->
            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement positionType="Float" x="0" y="200" width="515" height="70" uuid="aa000000-0000-0000-0000-000000000050"/>
                <textElement textAlignment="Left" verticalAlignment="Top" markup="html">
                    <font fontName="SansSerif" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA["Applicant / Co applicant Signature.<br/><br/>_______________________<br/><br/>_______________________"]]></textFieldExpression>
            </textField>

            <!-- =================== Authorized signatory block =================== -->
            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement positionType="Float" x="0" y="280" width="515" height="60" uuid="aa000000-0000-0000-0000-000000000051"/>
                <textElement textAlignment="Left" verticalAlignment="Top" markup="html">
                    <font fontName="SansSerif" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA["For : <b>Sarvagram Fincare Private Limited</b><br/><br/>____________________________<br/>Authorized Signatory"]]></textFieldExpression>
            </textField>

            <!-- =================== Branch & Registered Office =================== -->
            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement positionType="Float" x="0" y="350" width="515" height="16" uuid="aa000000-0000-0000-0000-000000000060"/>
                <textElement textAlignment="Left" verticalAlignment="Top">
                    <font fontName="SansSerif" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA["Branch: " + ($P{branchName} == null ? "" : $P{branchName})]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement positionType="Float" x="0" y="372" width="515" height="16" uuid="aa000000-0000-0000-0000-000000000061"/>
                <textElement textAlignment="Left" verticalAlignment="Top">
                    <font fontName="SansSerif" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA["Registered Office: " + ($P{officeAddress} == null ? "" : $P{officeAddress})]]></textFieldExpression>
            </textField>

        </band>
    </detail>

</jasperReport>
