                <textFieldExpression><![CDATA["Signature : ______________________________________"]]></textFieldExpression>
            </textField>
        </band>


        <!-- ===================== BAND 5 : SCHEDULE I (rows i-xi) ===================== -->
        <band height="545" splitType="Stretch">
            <break><reportElement positionType="Float" x="0" y="0" width="535" height="1" uuid="d5000000-0000-0000-0000-000000000000"/></break>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="1" width="535" height="16" uuid="d5000000-0000-0000-0000-000000000001"/><textElement textAlignment="Center"><font fontName="SansSerif" size="11" isBold="true"/></textElement><textFieldExpression><![CDATA["SCHEDULE - I"]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="17" width="535" height="14" uuid="d5000000-0000-0000-0000-000000000002"/><textElement textAlignment="Center"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["(Terms and conditions of the financial assistance)"]]></textFieldExpression></textField>

            <!-- (i) Date/Place -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="31" width="40" height="40" uuid="d5010000-0000-0000-0000-000000000001"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["(i)"]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="40" y="31" width="150" height="40" uuid="d5010000-0000-0000-0000-000000000002"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><topPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["Date and Place of Execution of this Deed"]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="190" y="31" width="345" height="40" uuid="d5010000-0000-0000-0000-000000000003"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><topPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["Date: " + ($F{currentDate} == null ? "" : $F{currentDate}) + "\n\nPlace: " + ($F{branchName} == null ? "" : $F{branchName})]]></textFieldExpression></textField>

            <!-- (ii) Borrower's Details -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="71" width="40" height="70" uuid="d5020000-0000-0000-0000-000000000001"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["(ii)"]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="40" y="71" width="150" height="70" uuid="d5020000-0000-0000-0000-000000000002"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["Borrower's Details:"]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="190" y="71" width="345" height="70" uuid="d5020000-0000-0000-0000-000000000003"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["Name: " + ($F{applicantName} == null ? "" : $F{applicantName}) + "\nAddress: " + ($F{applicantAddress} == null ? "" : $F{applicantAddress}) + "\nTel No: " + ($F{applicantMobile} == null ? "" : $F{applicantMobile}) + "\nEmail-id: "]]></textFieldExpression></textField>

            <!-- (iii) Co-Borrower Details (dynamic) -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="141" width="40" height="60" uuid="d5030000-0000-0000-0000-000000000001"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["(iii)"]]></textFieldExpression></textField>
