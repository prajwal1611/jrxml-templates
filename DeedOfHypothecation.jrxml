            <!-- (xviii) Part Prepayment -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="284" width="40" height="24" uuid="d6070000-0000-0000-0000-000000000001"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["(xviii)"]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="40" y="284" width="150" height="24" uuid="d6070000-0000-0000-0000-000000000002"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["Part Prepayment of Loan"]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="190" y="284" width="345" height="24" uuid="d6070000-0000-0000-0000-000000000003"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["2% of every part pre-payment amount + 18% GST"]]></textFieldExpression></textField>

            <!-- (xix) Foreclosure -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="308" width="40" height="70" uuid="d6080000-0000-0000-0000-000000000001"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["(xix)"]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="40" y="308" width="150" height="70" uuid="d6080000-0000-0000-0000-000000000002"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["Foreclosure Charges"]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="190" y="308" width="345" height="70" uuid="d6080000-0000-0000-0000-000000000003"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement textAlignment="Justified"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["Any foreclosure of the Loan shall attract prepayment charges at the rate of (a) 4% (four percent) of the outstanding amount of Loan in case prepayment is effectuated before the payment of 50% (fifty percent) of the total EMIs payable (in number) under the Loan + 18% GST; and (b) 3% (three percent) of the outstanding amount of Loan in case prepayment is effectuated after the payment of 50% (fifty percent) of the total EMIs payable (in number) under the Loan + 18% GST."]]></textFieldExpression></textField>

            <!-- (xx) Cheque dishonor -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="378" width="40" height="30" uuid="d6090000-0000-0000-0000-000000000001"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["(xx)"]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="40" y="378" width="150" height="30" uuid="d6090000-0000-0000-0000-000000000002"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["Cheque/ Instruction Dishonor Charges"]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="190" y="378" width="345" height="30" uuid="d6090000-0000-0000-0000-000000000003"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["INR 500 (Rupees Five Hundred Only) per instrument per instance"]]></textFieldExpression></textField>

            <!-- (xxi) Penal -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="408" width="40" height="24" uuid="d60a0000-0000-0000-0000-000000000001"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["(xxi)"]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="40" y="408" width="150" height="24" uuid="d60a0000-0000-0000-0000-000000000002"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["Penal Charges"]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="190" y="408" width="345" height="24" uuid="d60a0000-0000-0000-0000-000000000003"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["30% p.a. penal charges applicable on due non-payment of outstanding amount."]]></textFieldExpression></textField>

            <!-- (xxii) General Conditions -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="432" width="40" height="220" uuid="d60b0000-0000-0000-0000-000000000001"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["(xxii)"]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="40" y="432" width="150" height="220" uuid="d60b0000-0000-0000-0000-000000000002"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["General Conditions"]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="190" y="432" width="345" height="220" uuid="d60b0000-0000-0000-0000-000000000003"/><box leftPadding="3" rightPadding="3" topPadding="3" bottomPadding="3"><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box><textElement textAlignment="Justified"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["(i).  The Borrower agrees and authorises the Lender to debit to and recover from any account maintained by on or behalf of the Borrower with the Lender, now or in future, towards recovery of any and all costs, charges and expenses stipulated herein or in connection with or incidental to the Loan.\n\n(ii).  The Borrower shall upon demand pay to or reimburse the Lender in full:\n     a.  The legal costs of the preparation of loan/security document, creation of security etc.;\n     b.  All costs, expenses and other charges at actuals including but not limited to all costs, expenses and fees relating to the periodic valuation, title search, site visit, inspection, insurance and protection/preservation in any other manner of the security tendered to the Lender; and\n     c.  All costs (including legal fees) incurred by the Lender in preserving perfecting or enforcing any of its rights under or in respect of this letter/loan documents, or any present or future security and other documents.\n\n(iii).  The Borrower understands, acknowledges and agrees that the undrawn portion of the Loan may be cancelled and repudiated in part or in entirety by the Lender, at any time without notice and without giving any reason.\n\n(iv).  All costs, charges, interest rates are exclusive of applicable taxes.\n\n(v).  Change in Applicable Rate of Interest and other pricing parameters may be communicated by the Lender through any of the following modes - through Email ID as updated in Lender's records, letter sent to Borrower's address as updated in Lender's records, over website of the Lender, through account statements, through Short Message Service (SMS) or through its branches or such other medium as the Lender may consider appropriate."]]></textFieldExpression></textField>
        </band>
    </detail>
</jasperReport>
