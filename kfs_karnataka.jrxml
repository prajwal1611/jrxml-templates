						<font fontName="Noto Sans Kannada" size="9"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{emiDate} + " of every month"]]></textFieldExpression>
				</textField>
			</frame>
