					<font fontName="Noto Sans Kannada" size="9" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["ಸಾಲಕ್ಕಾಗಿ ಸಮೀಕರಿಸಿದ ಆವರ್ತಕ ಕಂತುಗಳ ಅಡಿಯಲ್ಲಿ ವಿವರಣಾತ್ಮಕ ಮರುಪಾವತಿ ವೇಳಾಪಟ್ಟಿಯಲ್ಲಿ ವಿವರಿಸಲಾಗಿದೆ"]]></textFieldExpression>
			</textField>
		</band>
