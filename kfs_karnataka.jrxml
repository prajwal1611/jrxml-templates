		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="e8a3a4c5-3387-4acf-8953-3b5e4f303a52"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="e10016aa-7819-4560-adb5-8eb6393a9e76"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["(xi)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="140" height="20" uuid="b48d7cb5-b306-4c1e-b161-3db118029b8d"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="true"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಸಾಮಾನ್ಯ ಪರಿಸ್ಥಿತಿಗಳು"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="170" y="0" width="325" height="20" uuid="59c1f8a9-8b50-4723-b2ef-92f352d46e15"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["I. ಸಾಲಕ್ಕೆ ಸಂಬಂಧಿಸಿದ ಅಥವಾ ಪ್ರಾಸಂಗಿಕವಾದ ಎಲ್ಲಾ ಮೊತ್ತಗಳು, ಶುಲ್ಕಗಳು ಮತ್ತು ವೆಚ್ಚಗಳ ವಸೂಲಾತಿಗಾಗಿ ಸಾಲಗಾರನ ಪರವಾಗಿ ನಿರ್ವಹಿಸಲಾಗುವ ಯಾವುದೇ ಖಾತೆಯಿಂದ ಡೆಬಿಟ್ ಮಾಡಲು ಮತ್ತು ಮರುಪಡೆಯಲು ಸಾಲಗಾರನು ಸಾಲದಾತನಿಗೆ ಒಪ್ಪುತ್ತಾನೆ ಮತ್ತು ಅಧಿಕಾರ ನೀಡುತ್ತಾನೆ.\n\nII. ಸಾಲಗಾರನು ಬೇಡಿಕೆಯ ಮೇರೆಗೆ ಸಾಲದಾತನಿಗೆ ಈ ಕೆಳಗಿನವುಗಳನ್ನು ಪಾವತಿಸಬೇಕು ಅಥವಾ ಮರುಪಾವತಿಸಬೇಕು:\nಎ. ಹಣಕಾಸು/ಭದ್ರತಾ ದಾಖಲೆ ತಯಾರಿಕೆ, ಭದ್ರತೆಯ ರಚನೆ ಇತ್ಯಾದಿಗಳ ಕಾನೂನು ವೆಚ್ಚಗಳು;\nಬಿ. ಆವರ್ತಕ ಮೌಲ್ಯಮಾಪನ, ಶೀರ್ಷಿಕೆ ಹುಡುಕಾಟ, ಸೈಟ್ ಭೇಟಿ, ತಪಾಸಣೆ, ವಿಮೆ ಮತ್ತು ಭದ್ರತೆಯ ರಕ್ಷಣೆಗೆ ಸಂಬಂಧಿಸಿದ ಎಲ್ಲಾ ವೆಚ್ಚಗಳು ಮತ್ತು ಶುಲ್ಕಗಳು;\nಸಿ. ಈ ಪತ್ರ/ಹಣಕಾಸು ದಾಖಲೆಗಳ ಅಡಿಯಲ್ಲಿ ಹಕ್ಕುಗಳನ್ನು ಪರಿಪೂರ್ಣಗೊಳಿಸಲು ಅಥವಾ ಜಾರಿಗೊಳಿಸಲು ಮಾಡಿದ ಎಲ್ಲಾ ವೆಚ್ಚಗಳು (ಕಾನೂನು ಶುಲ್ಕಗಳು ಸೇರಿದಂತೆ).\n\nIII. ಯಾವುದೇ ಸೂಚನೆ ನೀಡದೆ ಮತ್ತು ಯಾವುದೇ ಕಾರಣವನ್ನು ತಿಳಿಸದೆ ಸಾಲದ ವಿಲೇವಾರಿಯಾಗದ ಭಾಗವನ್ನು ಸಾಲದಾತನು ಯಾವುದೇ ಸಮಯದಲ್ಲಿ ರದ್ದುಗೊಳಿಸಬಹುದು ಎಂದು ಸಾಲಗಾರ ಅರ್ಥಮಾಡಿಕೊಂಡು ಒಪ್ಪಿಕೊಳ್ಳುತ್ತಾನೆ."]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="b0ad304a-f821-491c-8777-f6d977467bdc"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="1f880e6f-026c-48a5-89a8-b504656c29f1"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA[""]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="140" height="20" uuid="57459281-50eb-4951-9341-c3c11c934f8f"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA[""]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="170" y="0" width="325" height="20" uuid="1e50ff26-1ccb-4606-8c3e-c81fa0699e9f"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["IV. ಎಲ್ಲಾ ವೆಚ್ಚಗಳು, ಶುಲ್ಕಗಳು ಮತ್ತು ಬಡ್ಡಿದರಗಳು ಅನ್ವಯವಾಗುವ ತೆರಿಗೆಗಳನ್ನು ಹೊರತುಪಡಿಸಿವೆ.\n\nV. ಮೂಲ ಚರ/ಸ್ಥಿರ ಆಸ್ತಿ ದಾಖಲೆಗಳ ಬಿಡುಗಡೆ: ಸಾಲದ ಸಂಪೂರ್ಣ ಮರುಪಾವತಿ/ಇತ್ಯರ್ಥದ ನಂತರ 30 (ಮೂವತ್ತು) ದಿನಗಳೊಳಗೆ, ಸಾಲದ ಖಾತೆಯನ್ನು ನಿರ್ವಹಿಸಿದ ಶಾಖೆಯಿಂದ ಸಾಲಗಾರ(ರು) ಮೂಲ ದಾಖಲೆಗಳನ್ನು ಸಂಗ್ರಹಿಸಬಹುದು.\n\nVI. KYC ಮಾಹಿತಿ ಪರಿಶೀಲನೆ, ಕ್ರೆಡಿಟ್ ಅಪಾಯ ವಿಶ್ಲೇಷಣೆ ಅಥವಾ ಇತರ ಸಂಬಂಧಿತ ಉದ್ದೇಶಗಳಿಗಾಗಿ ಸಾಲದಾತನ ಇತರ ಶಾಖೆಗಳು, ಅಂಗಸಂಸ್ಥೆಗಳು, ಕ್ರೆಡಿಟ್ ಬ್ಯೂರೋಗಳು, ರೇಟಿಂಗ್ ಏಜೆನ್ಸಿಗಳು, ಬ್ಯಾಂಕ್‌ಗಳು/ಹಣಕಾಸು ಸಂಸ್ಥೆಗಳು, ಸರ್ಕಾರಿ/ನಿಯಂತ್ರಕ ಅಧಿಕಾರಿಗಳಿಗೆ ಮಾಹಿತಿ ಬಹಿರಂಗಪಡಿಸಲು ಸಾಲಗಾರ(ರು) ಸಾಲದಾತನಿಗೆ ಅಧಿಕಾರ ನೀಡುತ್ತಾರೆ ಮತ್ತು ಗೌಪ್ಯತೆಯ ಸವಲತ್ತುಗಳನ್ನು ಬಿಟ್ಟುಕೊಡುತ್ತಾರೆ.\n\nVII. ಅನ್ವಯವಾಗುವ ಬಡ್ಡಿದರ ಮತ್ತು ಇತರ ಬೆಲೆ ನಿಯತಾಂಕಗಳಲ್ಲಿನ ಬದಲಾವಣೆಯನ್ನು ಇಮೇಲ್, ಪತ್ರ, ವೆಬ್‌ಸೈಟ್, ಖಾತೆ ಹೇಳಿಕೆ, SMS ಅಥವಾ ಶಾಖೆಗಳ ಮೂಲಕ ಸಾಲದಾತನು ತಿಳಿಸಬಹುದು."]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="25" splitType="Stretch">
			<break>
				<reportElement x="0" y="0" width="495" height="1" uuid="b3a40005-0000-0000-0000-500000000303"/>
			</break>
			<textField>
				<reportElement style="TB" positionType="Float" x="0" y="5" width="495" height="18" uuid="feef7979-fd7d-466f-8183-dfb0cdcc27b8"/>
				<textElement textAlignment="Center">
					<font fontName="Noto Sans Kannada" size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["ಪ್ರದರ್ಶನ I"]]></textFieldExpression>
			</textField>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="0795dfb8-0e1d-4f3e-b4f3-48bb3265757e"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="40" height="20" uuid="5bb6d7df-3d78-494c-a0ef-0338c188ae11"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["1"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="40" y="0" width="240" height="20" uuid="7bac80e5-941c-48d9-a6f5-deab4be29ec3"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಮಂಜೂರಾದ ಸಾಲದ ಮೊತ್ತ (ರೂಪಾಯಿಗಳಲ್ಲಿ) (ಕ್ರಮ ಸಂಖ್ಯೆ. KFS ನ 2 - ಭಾಗ 1)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="TC" x="280" y="0" width="215" height="20" uuid="b4e27cb0-e2d1-4ff3-b90c-d74a1ff3b22f"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{amount}]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="eca1db3f-a718-4d73-b17a-8e258895daf1"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="40" height="20" uuid="af326689-bc73-43c7-a714-b38a9eb7b9db"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["2"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="40" y="0" width="240" height="20" uuid="e7847fd8-7e31-4bf5-9b55-1fe1bb551ecc"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಸಾಲದ ಅವಧಿ (ವರ್ಷಗಳು/ ತಿಂಗಳುಗಳು/ ದಿನಗಳಲ್ಲಿ) (ಕ್ರಮ ಸಂಖ್ಯೆ. KFS ನ ಸಂಖ್ಯೆ 4 – ಭಾಗ 1)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="TC" x="280" y="0" width="215" height="20" uuid="7a83f287-09db-41bd-b201-a7397929aca8"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{tenure} + " Months"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="33e75310-31ce-4383-8cef-8683e2bf1efd"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="40" height="20" uuid="77df9e56-02e9-484e-ab09-0076859eae6a"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["a)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="40" y="0" width="240" height="20" uuid="d0805ca3-9a8e-4141-886b-b463b14ffb96"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಸಮಾನವಲ್ಲದ ಆವರ್ತಕ ಸಾಲಗಳ ಸಂದರ್ಭದಲ್ಲಿ ಅಸಲು ಪಾವತಿಗೆ ಕಂತುಗಳ ಸಂಖ್ಯೆ"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="280" y="0" width="215" height="20" uuid="c8130ec6-6a44-4146-bd48-7ffd69a1b037"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["N.A."]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="fe41c9b4-3c80-4edf-b470-b10fd06e51d0"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="40" height="20" uuid="400531f4-8b07-4a6b-bb00-f3968d7e2206"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["b)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="40" y="0" width="240" height="20" uuid="4acd5aa1-8451-4684-9c9c-e00c6fdec126"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["EPI ಪ್ರಕಾರ\nಪ್ರತಿ EPI ಮೊತ್ತ (ರೂಪಾಯಿಗಳಲ್ಲಿ) ಮತ್ತು EPIಗಳ ಸಂಖ್ಯೆ (ಕ್ರಮ ಸಂಖ್ಯೆ. KFS ನ ಸಂಖ್ಯೆ 5 – ಭಾಗ 1)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="280" y="0" width="215" height="20" uuid="83ac7e55-d617-4352-a88b-5715dfaac0d2"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಮಾಸಿಕ"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="d53b73f0-e7d6-4ddd-9c59-2686ad1cfd5d"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="40" height="20" uuid="41dea33b-0786-4ee1-95f5-14f96e0eb4e9"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["c)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="40" y="0" width="240" height="20" uuid="1aec2f77-de93-4511-9409-f2d6a4e0ff0e"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಬಂಡವಾಳೀಕರಿಸಿದ ಬಡ್ಡಿಯನ್ನು ಪಾವತಿಸಲು ಕಂತುಗಳ ಸಂಖ್ಯೆ, ಯಾವುದಾದರೂ ಇದ್ದರೆ"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="280" y="0" width="215" height="20" uuid="0116535f-1faf-4352-9915-fc39c233d904"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["N.A."]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="dcbab191-a698-4cf6-916b-9d26ed5edc71"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="40" height="20" uuid="2e936ca8-97ab-47c9-99b8-cee96650a3e9"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["d)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="40" y="0" width="240" height="20" uuid="b6a2e2d7-cb0a-4797-a87c-1aa20f3a4a23"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಮರುಪಾವತಿಯ ಪ್ರಾರಂಭ, ಮಂಜೂರಾತಿ ನಂತರ (ಕ್ರಮ ಸಂಖ್ಯೆ. KFS ನ ಸಂಖ್ಯೆ 5 – ಭಾಗ 1)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="TC" x="280" y="0" width="215" height="20" uuid="daefc41c-a0fe-4e94-853b-da3a5e33236a"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{repaymentDate}]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="9f95f51a-0824-4f6d-832c-4d640853ca60"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="40" height="20" uuid="8010513a-7773-43f1-b399-3305f405d867"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["3"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="40" y="0" width="240" height="20" uuid="1bb8543a-54dd-49e1-9eee-6d11d55041b6"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಬಡ್ಡಿದರ (%) ಮತ್ತು ಪ್ರಕಾರ (ಫಿಕ್ಸೆಡ್ ಅಥವಾ ಫ್ಲೋಟಿಂಗ್‌ ಅಥವಾ ಹೈಬ್ರಿಡ್) (ಕ್ರಮ ಸಂಖ್ಯೆ KFS ನ ಸಂಖ್ಯೆ 6 – ಭಾಗ 1)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="280" y="0" width="215" height="20" uuid="e4e56b89-8caf-4fc9-aade-6f2b94803083"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಸರಿಪಡಿಸಲಾಗಿದೆ"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="c700d776-ab34-4ffc-b2e0-38099fe1f4c4"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="40" height="20" uuid="e9ec1a0b-a743-4a5b-a0cd-577a0ffc2109"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["4"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="40" y="0" width="240" height="20" uuid="8d7cb72b-7575-4b19-a308-aa47b0882df4"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಬಡ್ಡಿ ದರ (ಕ್ರಮ ಸಂಖ್ಯೆ KFS ನ ಸಂಖ್ಯೆ 6 – ಭಾಗ 1)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="TC" x="280" y="0" width="215" height="20" uuid="5ec64e0e-9151-438d-94e2-844ef73a3806"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{roi}]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="722b9a32-b12c-465c-8708-bb6bb834ed87"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="40" height="20" uuid="f12e717a-8cfc-48c0-af2d-24ba9ef070f4"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["5"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="40" y="0" width="240" height="20" uuid="cc47051e-b03c-49d1-983a-e013a4717e1e"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಮಂಜೂರಾತಿ ದಿನಾಂಕದಂದು (ರೂಪಾಯಿಗಳಲ್ಲಿ) ಚಾಲ್ತಿಯಲ್ಲಿರುವ ದರಕ್ಕೆ ಅನುಗುಣವಾಗಿ ಸಾಲದ ಸಂಪೂರ್ಣ ಅವಧಿಯಲ್ಲಿ ವಿಧಿಸಬೇಕಾದ ಒಟ್ಟು ಬಡ್ಡಿ ಮೊತ್ತ"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="TC" x="280" y="0" width="215" height="20" uuid="1b574833-fee3-40c7-8727-56bd1b87a6e9"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{totalInterestAmount}]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="2cdf7572-ddeb-4adb-a736-024c567e195c"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="40" height="20" uuid="50ee9ce2-7df8-4df3-818f-20c6c9612000"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["6"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="40" y="0" width="240" height="20" uuid="44457fc0-c088-4cb4-931b-edf09f8cad2c"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಪಾವತಿಸಬೇಕಾದ ಶುಲ್ಕ/ ಶುಲ್ಕಗಳು (ರೂಪಾಯಿಗಳಲ್ಲಿ)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="280" y="0" width="215" height="20" uuid="79e4ed90-3d8b-429b-bb1f-35ee6f7a7e4d"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA[""]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="9f1433c9-18b3-49d3-94f6-720bf69da546"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="40" height="20" uuid="80a78b9d-2a3a-4f8f-a23e-3e44128d73e6"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["A"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="40" y="0" width="240" height="20" uuid="7ffeda0e-4758-43b8-941b-30fb23d54f26"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["RE ಗೆ ಪಾವತಿಸಬೇಕಿರುವುದು (ಕ್ರಮ ಸಂಖ್ಯೆ KFS ನ ಸಂಖ್ಯೆ .8 A - ಭಾಗ 1)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="TC" x="280" y="0" width="215" height="20" uuid="2e36d2ae-4078-4d5c-8b77-c5e5f0ca5552"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{rePayable}]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="3478eba3-d4d0-41e4-a3ad-6f0832648f0d"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="40" height="20" uuid="92198373-c3ff-43c5-802b-63942aec6a88"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["B"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="40" y="0" width="240" height="20" uuid="c327cee5-e9ad-4c44-9a2e-837115cb32b4"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["RE ಮೂಲಕ ಮೂರನೇ ವ್ಯಕ್ತಿಗೆ ಪಾವತಿಸುವುದು (ಕ್ರಮ ಸಂಖ್ಯೆ KFS ನ ಸಂಖ್ಯೆ .8 B – ಭಾಗ 1)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="TC" x="280" y="0" width="215" height="20" uuid="d14d294a-cd2e-4f6d-bee0-9ec0f25453a0"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{reThirdPartyPayable}]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="3020bd49-3e14-4606-aa09-5edd4be5ad39"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="40" height="20" uuid="a4961063-9d28-4f3c-bac5-e526c8f55215"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["7"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="40" y="0" width="240" height="20" uuid="fa04838d-47d1-4d41-97cf-3fdeb481575e"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ವಿತರಿಸಿದ ನಿವ್ವಳ ಮೊತ್ತ (1-6) (ರೂಪಾಯಿಗಳಲ್ಲಿ)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="TC" x="280" y="0" width="215" height="20" uuid="4267823d-70ea-4048-b946-58c2891d3249"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{netDisbursementAmount}]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="d784d812-e357-48a6-b5eb-bc0098fd3755"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="40" height="20" uuid="f8087663-137f-469d-b646-bc2ebc960a0f"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["8"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="40" y="0" width="240" height="20" uuid="30ea9a4f-ccf3-4680-ad2c-c598147bc50a"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಸಾಲಗಾರರು ಪಾವತಿಸಬೇಕಾದ ಒಟ್ಟು ಮೊತ್ತ (1 ಮತ್ತು 5 ರ ಮೊತ್ತ) (ರೂಪಾಯಿಗಳಲ್ಲಿ)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="TC" x="280" y="0" width="215" height="20" uuid="06de67a3-bbd4-4313-9d20-70f13a4a3efc"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{borrowerAmount}]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="ab03802f-cb82-4c04-8810-0a54aea163bd"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="40" height="20" uuid="dcb8c247-2ed7-457e-982b-d93024c03c26"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["9"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="40" y="0" width="240" height="20" uuid="31d0b7d1-b09e-44fa-b62a-b7331a34dbef"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ವಾರ್ಷಿಕ ಶೇಕಡಾವಾರು ದರ- ಪರಿಣಾಮಕಾರಿ ವಾರ್ಷಿಕ ಬಡ್ಡಿದರ (ಶೇಕಡಾವಾರು) (ಕ್ರಮ ಸಂಖ್ಯೆ KFS ನ ಸಂಖ್ಯೆ 9 - ಭಾಗ 1)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="TC" x="280" y="0" width="215" height="20" uuid="f80748ae-3cf1-4a75-ada5-1b93a50091b7"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{aprPercentage}]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="25" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="25" uuid="674841e5-6727-4735-8867-8e285b14c4da"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="40" height="25" uuid="1e63e040-1aca-4a7d-8a16-a87d64e849e0"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
					</textElement>
					<textFieldExpression><![CDATA["10"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="40" y="0" width="240" height="25" uuid="054d6ca1-d75d-4030-afb8-f61a6922e1ec"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ನಿಯಮಗಳು ಮತ್ತು ಷರತ್ತುಗಳ ಪ್ರಕಾರ ವಿತರಣೆಯ ವೇಳಾಪಟ್ಟಿ"]]></textFieldExpression>
				</textField>
				<frame>
					<reportElement style="TC" stretchType="ContainerHeight" x="280" y="0" width="215" height="25" uuid="77962a02-3ee0-4f5f-950a-90b0a5c5dd12"/>
					<textField>
						<reportElement x="0" y="0" width="72" height="15" uuid="60ac114c-7457-4987-900d-dfe4e9dba586"/>
						<box>
							<pen lineWidth="0.5"/>
						</box>
						<textElement textAlignment="Center" verticalAlignment="Middle">
							<font fontName="Noto Sans Kannada" size="7" isBold="true"/>
						</textElement>
						<textFieldExpression><![CDATA["Tranche Number"]]></textFieldExpression>
					</textField>
					<textField>
						<reportElement x="72" y="0" width="72" height="15" uuid="6daf44ec-5865-4a14-abb3-395632922010"/>
						<box>
							<pen lineWidth="0.5"/>
						</box>
						<textElement textAlignment="Center" verticalAlignment="Middle">
							<font fontName="Noto Sans Kannada" size="7" isBold="true"/>
						</textElement>
						<textFieldExpression><![CDATA["Amount (Rs.)"]]></textFieldExpression>
					</textField>
					<textField>
