					</textElement>
					<textFieldExpression><![CDATA["ಬೇಂಚ್ಮಾರ್ಕ್ ರೇಟ್ (%) (B)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TCB" stretchType="ContainerHeight" x="124" y="0" width="62" height="40" uuid="c1500001-0000-0000-0000-000000000004"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="8" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA["ಸ್ಪ್ರೆಡ್ (%) (S)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TCB" stretchType="ContainerHeight" x="186" y="0" width="62" height="40" uuid="c1500001-0000-0000-0000-000000000005"/>
