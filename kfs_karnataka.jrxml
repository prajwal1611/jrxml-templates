		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="dcfa3659-f7f9-4014-baca-2d41c41b6b8e"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="549f76b2-ab27-4695-a4f2-461e751b020a"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA["2"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="240" height="20" uuid="24102f6e-9ffb-4a79-8138-01dc196f372b"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="true"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಮಂಜೂರಾದ ಸಾಲದ ಮೊತ್ತ (ರೂ ಪಾಯಿಗಳಲ್ಲಿ)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="TC" x="270" y="0" width="225" height="20" uuid="a3b8b719-8aff-4221-9d5d-d423be707bcb"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{amount}]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="ce997e15-b80e-4527-9cec-ea04b6664c23"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="7eb6e5b2-359b-471e-be42-3e183000ed79"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA["3"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="240" height="20" uuid="7a4ebb6b-06cf-4073-90f6-44ff5cc5efd1"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ವಿತರಣೆ ವೇಳಾಪಟ್ಟಿ\n(i) ಹಂತಗಳಲ್ಲಿ ಅಥವಾ 100% ಮುಂಗಡ ವಿತರಣೆ\n(ii) ಹಂತವಾರು ಆಗಿದ್ದರೆ, ಸಂಬಂಧಿತ ವಿವರಗಳನ್ನು ಹೊಂದಿರುವ ಸಾಲ ಒಪ್ಪಂದದ ಷರತ್ತನ್ನು ನಮೂದಿಸಿ"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="270" y="0" width="225" height="20" uuid="64782983-4f9e-4519-a6e2-7167791c3820"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಕೆಳಗಿನ ಭಾಗ 3(vii) ನಲ್ಲಿ ಒದಗಿಸಿದಂತೆ."]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="8e6e8f06-c357-48ea-92aa-27c9b9eef7cf"/>
