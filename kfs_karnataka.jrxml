				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="40" y="0" width="240" height="20" uuid="f75822a6-48ca-499c-b6ee-807d1bb12f0a"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಕಂತು ಮತ್ತು ಬಡ್ಡಿಯನ್ನು ಪಾವತಿಸಬೇಕಾದ ದಿನಾಂಕ"]]></textFieldExpression>
