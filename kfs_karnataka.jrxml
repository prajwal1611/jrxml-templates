				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="5e676af8-121f-4d39-ab29-5a9b4a2272bf"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="b6bb1abb-1722-476f-8a1e-de5f31eeffc0"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
					</textElement>
					<textFieldExpression><![CDATA["(v)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="100" height="20" uuid="a4dca5c2-e023-4513-8a97-ce77362d6524"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
						<paragraph leftIndent="2"/>
					</textElement>
					<textFieldExpression><![CDATA["ಯಾವುದೇ ಇತರ (ದಯವಿಟ್ಟು ನಿರ್ದಿಷ್ಟಪಡಿಸಿ) – ಸ್ಟಾಂಪ್ ಡ್ಯೂಟಿ ಶುಲ್ಕಗಳು"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="130" y="0" width="60" height="20" uuid="8e40e72e-8514-4caf-83a0-163fd1cab2eb"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="8"/>
					</textElement>
					<textFieldExpression><![CDATA["ಅನ್ವಯಿಸುವುದಿಲ್ಲ"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="TC" stretchType="ContainerHeight" x="190" y="0" width="80" height="20" uuid="3919ec2b-f067-4414-bfa5-b1ac8a53b0f7"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
					</textElement>
					<textFieldExpression><![CDATA["ಅನ್ವಯಿಸುವುದಿಲ್ಲ"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="270" y="0" width="60" height="20" uuid="7167ec46-bae1-4183-b7fb-90fab9a9d6cd"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="8"/>
					</textElement>
					<textFieldExpression><![CDATA["ಒಂದು ಬಾರಿ"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="TC" stretchType="ContainerHeight" x="330" y="0" width="165" height="20" uuid="2b065c38-c398-42bb-8ad0-665e370a6276"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9"/>
