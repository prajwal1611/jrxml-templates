		<band height="40" splitType="Prevent">
			<textField textAdjust="StretchHeight">
				<reportElement style="T" positionType="Float" x="0" y="2" width="495" height="38" uuid="a956d012-bc05-4a0c-9a46-7b73fcccded4"/>
				<textElement textAlignment="Justified">
					<font fontName="Noto Sans Kannada" size="9" isItalic="true"/>
				</textElement>
				<textFieldExpression><![CDATA["** ಈ ಮರುಪಾವತಿ ವೇಳಾಪಟ್ಟಿ ತಾತ್ಕಾಲಿಕವಾಗಿದೆ. ಅಂತಿಮ ಮರುಪಾವತಿ ವೇಳಾಪಟ್ಟಿಯನ್ನು ಸಾಲದ ವಿತರಣೆಯ ನಂತರ ಪ್ರತ್ಯೇಕವಾಗಿ ಒದಗಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ಸಾಲದ ಮರುಪಾವತಿಯ ನಿಖರವಾದ ದಿನಾಂಕಗಳು, ಅಸಲು ಮತ್ತು ಬಡ್ಡಿಯ ನಡುವಿನ ವಿಭಜನೆ, ಮರುಪಾವತಿಯ ಪ್ರಾರಂಭದ ನಿಖರವಾದ ದಿನಾಂಕ ಇತ್ಯಾದಿ ವಿವರಗಳನ್ನು ಒಳಗೊಂಡಿರುತ್ತದೆ."]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
