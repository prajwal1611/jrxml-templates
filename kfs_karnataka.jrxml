			<textField>
				<reportElement style="TB" x="0" y="18" width="495" height="18" uuid="885e114b-e342-47b7-96cc-6d4b0de88b19"/>
				<textElement textAlignment="Center">
					<font fontName="Noto Sans Kannada" size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["ಪ್ರಮುಖ ಸಂಗತಿಗಳ ಹೇಳಿಕೆ"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement style="TB" x="0" y="36" width="495" height="18" uuid="8249d591-de0e-4200-b37e-7cf988d04e46"/>
				<textElement textAlignment="Center">
					<font fontName="Noto Sans Kannada" size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["ಭಾಗ 1 (ಬಡ್ಡಿ ದರ ಮತ್ತು ಫೀಗಳು/ಶುಲ್ಕಗಳು)"]]></textFieldExpression>
			</textField>
		</band>
	</title>
