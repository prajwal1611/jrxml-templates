					</textElement>
					<textFieldExpression><![CDATA["(v)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="140" height="20" uuid="bf0d5396-613a-4b97-ac67-965a131cbd7f"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="true"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಮರುಪಾವತಿ ವಿಧ"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="170" y="0" width="325" height="20" uuid="686689de-d90d-4f69-ab30-bd1fb5d64bad"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["[●] ನ್ಯಾಷನಲ್ ಆಟೋಮೇಟೆಡ್ ಕ್ಲಿಯರಿಂಗ್ ಹೌಸ್ (ನಾಚ್)"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="25" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="25" uuid="ff16dffd-d845-48f5-91e8-48ecce66a9f3"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="25" uuid="2f518f18-d842-4319-a066-752e8fd20775"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10"/>
					</textElement>
					<textFieldExpression><![CDATA["(vi)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TCB" stretchType="ContainerHeight" x="30" y="0" width="140" height="25" uuid="9fa38be0-f334-4bfb-bd9c-14208677e976"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="true"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಭದ್ರತೆ"]]></textFieldExpression>
				</textField>
				<frame>
					<reportElement style="TC" stretchType="ContainerHeight" x="170" y="0" width="325" height="25" uuid="53cd262e-eec1-4d5b-8238-d8baba9dd990"/>
					<componentElement>
						<reportElement x="2" y="2" width="321" height="20" uuid="d9203a2d-0c6f-4985-a8d8-f6374760dd27"/>
						<jr:list xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd" printOrder="Vertical">
							<datasetRun subDataset="CollateralSecurityDS" uuid="d7eff6c6-aceb-4c84-b2f1-a108269edaf8">
								<dataSourceExpression><![CDATA[$P{CollateralSecurityListDS}]]></dataSourceExpression>
							</datasetRun>
							<jr:listContents height="90" width="321">
								<textField textAdjust="StretchHeight" isBlankWhenNull="true">
									<reportElement x="0" y="0" width="321" height="90" uuid="4b785fa7-5eda-4218-851e-7307cc4e65bf"/>
									<textElement>
										<font fontName="Noto Sans Kannada" size="9"/>
									</textElement>
									<textFieldExpression><![CDATA["ಫಿಕ್ಸೆಡ್/ಚಲಿಸಬಲ್ಲ ಆಸ್ತಿಯ ಮೇಲೆ ವಿಶೇಷ ಅಡಮಾನ ಮತ್ತು ಶುಲ್ಕ\nಭದ್ರತೆ – ಫಿಕ್ಸೆಡ್ / ಚಲಿಸಬಲ್ಲ\nಭದ್ರತಾ ಪ್ರಕಾರ – ಆಸ್ತಿ\nಅಂದಾಜು ಮೌಲ್ಯ : " + $F{totalAmount} + "\nವಿಳಾಸ(ಅಚಲ) : " + $F{propertyAddress} + "\n────────────────────\nಡಿಮ್ಯಾಂಡ್ ಪ್ರಾಮಿಸರಿ ನೋಟ್ (DPN)\nಸಾಲದ ಅಡಿಯಲ್ಲಿ 1ನೇ (ಮೊದಲ) ವಿತರಣೆಯ ಮೊದಲು ಭದ್ರತೆಯನ್ನು ರಚಿಸಬೇಕು."]]></textFieldExpression>
								</textField>
							</jr:listContents>
						</jr:list>
					</componentElement>
				</frame>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="c6725279-32ac-4d2d-9254-c46fedcb9642"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="f14495a3-87c9-45c4-ad67-deaa203e0d03"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["(vii)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="140" height="20" uuid="a7c23d3b-832d-4460-adbe-2dac026139d6"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="true"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಸಾಲದ ಭಾಗ ಪೂರ್ವಪಾವತಿ"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="170" y="0" width="325" height="20" uuid="76dc2277-005e-47ad-b804-6d972f268a6d"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಪ್ರತಿ ಭಾಗದ ಪೂರ್ವ-ಪಾವತಿ ಮೊತ್ತದ 2%, ಜೊತೆಗೆ ಅನ್ವಯವಾಗುವ ತೆರಿಗೆಗಳು."]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="56812ae3-a737-4866-a314-4b0bda93a4ac"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="80834f88-d23a-4bca-8627-fa3666bbaf75"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["(viii)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="140" height="20" uuid="d047b52d-574a-457a-9890-37b17e6f4a0d"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="true"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಲಭ್ಯತೆಯ ಅವಧಿ"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="170" y="0" width="325" height="20" uuid="ab5f3caf-5e4f-45f5-9325-cad1c8d3684a"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["60 (ಅರವತ್ತು) ದಿನಗಳು"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="0733a20e-9c3d-4ee5-a3ca-0cd7c8e954a2"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="6ff6c8ea-b085-40d5-ae92-c52439bc2097"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["(ix)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="140" height="20" uuid="f4b66873-75e1-4716-86ab-fe4ab093aef1"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="true"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಮೊರಾಟೋರಿಯಂ ಅವಧಿ (ಯಾವುದಾದರೂ ಇದ್ದರೆ)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="170" y="0" width="325" height="20" uuid="8e113b2f-2cab-46d7-8531-d2fa0dbe0405"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಅನ್ವಯಿಸುವುದಿಲ್ಲ"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="25" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="25" uuid="722d831c-dee9-4851-ae72-9a6296ceff2f"/>
				<textField textAdjust="StretchHeight">
