			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="dbb0ad8f-2216-41b9-96de-b76a3e686dc5"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="4ec75b62-faf9-4560-87f9-dd0d9f0393b2"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA["9"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="240" height="20" uuid="ef51f23b-7cd7-4c88-a6bb-a78823660d57"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ವಾರ್ಷಿಕ ಶೇಕಡಾವಾರು ದರ (APR) (%)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="TC" x="270" y="0" width="225" height="20" uuid="f47f65a2-e3b0-464b-909c-e823aa51772c"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{aprPercentage}]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="9c0fada0-2335-4687-9b23-ed7bf48659dd"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="3ccde0a9-0538-4ec5-bf0d-9677270f8bc5"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA["10"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="465" height="20" uuid="8523b15e-3bb2-4c29-a827-84e49b5a7d8b"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="true"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಅನಿಶ್ಚಿತ ಶುಲ್ಕಗಳ ವಿವರಗಳು (₹ ಅಥವಾ % ನಲ್ಲಿ, ಅನ್ವಯವಾಗುವಂತೆ)"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="bb67b04b-7ac3-4f6c-a3bb-f6393b621c58"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="ecc1a65b-01d7-4309-b486-355c7f1cc150"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["(i)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="240" height="20" uuid="25a46de5-a080-4454-8bd5-dd674ee1d032"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ವಿಳಂಬ ಪಾವತಿಯ ಸಂದರ್ಭದಲ್ಲಿ ದಂಡದ ಶುಲ್ಕಗಳು, ಯಾವುದಾದರೂ ಇದ್ದರೆ"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="270" y="0" width="225" height="20" uuid="9c135ab3-e698-470c-921e-e6cf3a5bc51e"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["30% ವರ್ಷಕ್ಕೆ ಹಾಗು ಅವಧಿ ಮೀರಿದ ಅಸಲು ಮೊತ್ತದ ಮೇಲೆ ಅನ್ವಯವಾಗುವ ತೆರಿಗೆಗಳು"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="35e69f16-4fb9-4126-aff6-658531c00f39"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="59ac318a-abd2-416a-959d-fd3c75c109b2"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["(ii)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="240" height="20" uuid="c1f7b73a-0ccb-411b-9fed-ac7785c69a0a"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಇತರ ದಂಡದ ಶುಲ್ಕಗಳು, ಯಾವುದಾದರೂ ಇದ್ದರೆ (ಚೆಕ್/ ನಾಚ್ ಡಿಸಾನರ್ ಅಥವಾ ಬೌನ್ಸ್ ಶುಲ್ಕಗಳು)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="TC" x="270" y="0" width="225" height="20" uuid="c63b96a9-dd17-49ba-81f6-529230dc4e8f"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಪ್ರತಿ ಬಾರಿ ರೂ. " + $P{bouncingCharges} + " ಜೊತೆಗೆ ಅನ್ವಯವಾಗುವ ತೆರಿಗೆಗಳು"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="b4476ad8-3cde-4dc4-b720-060353ffa0ee"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="4afb5458-c39c-4943-ab41-17bcfd8e82f4"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["(iii)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="240" height="20" uuid="cc4de892-790e-4c48-b567-57a5530ad34b"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಸ್ವತ್ತುಮರುಸ್ವಾಧೀನ ಶುಲ್ಕಗಳು, ಅನ್ವಯಿಸಿದರೆ"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="270" y="0" width="225" height="20" uuid="52e1a13f-d116-418a-84e6-021d1e67557d"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["50% EMI ಪಾವತಿಸುವ ಮೊದಲು 4%, 50% EMI ನಂತರ 3% ಜೊತೆಗೆ ಅನ್ವಯಿಸುವ ತೆರಿಗೆಗಳು"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="434fa719-d129-40d3-9122-7e0aa1bbf343"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="8e38aba1-cf60-4dc8-8cac-f85a1f130c9b"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["(iv)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="240" height="20" uuid="f231885d-07f3-4f9d-8823-be132a987e11"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಫ್ಲೋಟಿಂಗ್‌ನಿಂದ ಫಿಕ್ಸೆಡ್ ದರಕ್ಕೆ ಸಾಲಗಳನ್ನು ಬದಲಾಯಿಸುವ ಶುಲ್ಕಗಳು ಹಾಗು ತದ್ವಿರುದ್ಧ"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="270" y="0" width="225" height="20" uuid="f02f513c-b90a-4566-99f8-b9053bed3b12"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಅನ್ವಯಿಸುವುದಿಲ್ಲ"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="ef9933bb-734b-41ac-be98-e5ed8df93097"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="79bbd352-5592-4e24-826f-3cc70569dc28"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["(v)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="240" height="20" uuid="819c9bbe-3052-49a4-a074-6f8fb51fd514"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಯಾವುದೇ ಇತರ ಶುಲ್ಕಗಳು (ನಿರ್ದಿಷ್ಟ ಪಡಿಸಿ)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="TC" x="270" y="0" width="225" height="20" uuid="9e561898-5b9e-4c5c-bb11-d9587d1fbdb9"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{otherDeductions}]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Prevent">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="15a63bf4-eac5-4a17-8eeb-a73706a34726"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="5b1e6199-3c32-4eb9-a21b-3c91a726c2e1"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["(vi)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="465" height="20" uuid="325ddc06-4205-476c-88a5-0e47f2d68084"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="9" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಥರ್ಡ್ ಪಾರ್ಟಿ ಪೇಮೆಂಟ್ ಗೇಟ್‌ವೇ ಶುಲ್ಕಗಳ ಕುರಿತು ಸೂಚನೆ:\nಕಂಪನಿ ನಿಯಮಿತ EMI ಪಾವತಿಗೆ ಯಾವುದೇ ಶುಲ್ಕವನ್ನು ವಿಧಿಸುವುದಿಲ್ಲ. ಮೊಬೈಲ್ ಆಪ್ ಅಥವಾ ಇತರ ಯಾವುದೇ ಆನ್‌ಲೈನ್ ವಿಧಾನಗಳ ಮೂಲಕ ಥರ್ಡ್ ಪಾರ್ಟಿ ಪೇಮೆಂಟ್ ಗೇಟ್‌ವೇ ಮೂಲಕ ಮಾಡಿದ ಪಾವತಿಗಳ ಮೇಲೆ, ಅನ್ವಯಿಸಿದರೆ, ಥರ್ಡ್ ಪಾರ್ಟಿ ಪೇಮೆಂಟ್ ಸೇವಾ ಪೂರೈಕೆದಾರರಿಂದ ಕನ್ವೀನಿಯನ್ಸ್ ಫೀ/ಸೇವಾ ಶುಲ್ಕಗಳನ್ನು ವಿಧಿಸಬಹುದು."]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="25" splitType="Stretch">
			<break>
				<reportElement x="0" y="0" width="495" height="1" uuid="b3a40004-0000-0000-0000-500000000302"/>
			</break>
			<textField>
				<reportElement style="TB" positionType="Float" x="0" y="5" width="495" height="18" uuid="97f85579-8af6-4e9b-9607-7f8dca6ca9a7"/>
				<textElement textAlignment="Center">
					<font fontName="Noto Sans Kannada" size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["ಭಾಗ 2 (ಇತರ ಗುಣಾತ್ಮಕವಾದ ಮಾಹಿತಿ)"]]></textFieldExpression>
			</textField>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="569f3237-d662-4f9d-bd68-ecfcfd92029b"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="04d1c4c8-d53e-4adf-a23f-5d791b55b7ff"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["1"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="240" height="20" uuid="f06f09a1-8429-41db-b708-fa99ea472c03"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ವಸೂಲಾತಿ ಏಜೆಂಟ್‌ಗಳ ತೊಡಗಿಸಿಕೊಳ್ಳುವಿಕೆಗೆ ಸಂಬಂಧಿಸಿದ ಸಾಲ ಒಪ್ಪಂದದ ಷರತ್ತು"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="270" y="0" width="225" height="20" uuid="44b6d496-63cb-463a-9dde-2d7d680f5535"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["N.A."]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="b845cb2d-b05e-4941-bf8e-33ed74618072"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="4d64df49-6f1e-4778-ac30-a6342daa71aa"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["2"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="240" height="20" uuid="883c2c4b-3dbf-4daa-a966-e3b815e89cb8"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಕುಂದುಕೊರತೆ ಪರಿಹಾರ ಕಾರ್ಯವಿಧಾನವನ್ನು ವಿವರಿಸುವ ಸಾಲ ಒಪ್ಪಂದದ ಷರತ್ತು"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="270" y="0" width="225" height="20" uuid="79c39f08-bbe4-43fa-ba7a-8dae68c9b30c"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಷರತ್ತು 12.11"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="fc580df6-5cc0-4b68-8e18-af3849bdeae3"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="ff7a7055-4ff7-433a-a48a-0763e96be483"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["3"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="240" height="20" uuid="b40eab87-b1bd-4cca-b637-28a5555f464c"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ನೋಡಲ್/ಕುಂದುಕೊರತೆ ನಿವಾರಣಾ ಆಫೀಸರ್ ಫೋನ್ ನಂಬರ್ ಮತ್ತು ಇಮೇಲ್ ID"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="270" y="0" width="225" height="20" uuid="81983d1e-5b28-4fae-abd5-e51eba426c05"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಶ್ರೀಮತಿ ಅಶ್ವಿನಿ ಪೂಜಾರಿ\nಹುದ್ದೆ: ಕುಂದುಕೊರತೆ ನಿವಾರಣಾ ಅಧಿಕಾರಿ\n+91 8101777555\nವಿಳಾಸ: ಪ್ರಮುಖ್ ಪ್ಲಾಜಾ, B ವಿಂಗ್, 603, ಚಕಲಾ, ಅಂಧೇರಿ (E), ಮುಂಬೈ – 400099, ಮಹಾರಾಷ್ಟ್ರ\nಇ-ಮೇಲ್: care@sarvagram.com / ashwini.pujari@sarvagram.com"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="97068ee5-4048-4da1-b91c-0cab5a4a0813"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="89d3759f-4aa0-404b-94f4-1a4403de637f"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["4"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="240" height="20" uuid="265c6032-ead4-4c3f-9d20-c03d0c09bc04"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಸಾಲವು ಇತರ RE ಅಥವಾ ಸೆಕ್ಯುರಿಟೈಸೇಶನ್‌ಗೆ ವರ್ಗಾವಣೆಗೆ ಒಳಪಟ್ಟಿದೆ ಅಥವಾ ಭವಿಷ್ಯದಲ್ಲಿ ಒಳಪಡಲಿದೆ (ಹೌದು/ ಇಲ್ಲ)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="270" y="0" width="225" height="20" uuid="85caf7eb-b72a-49d4-995d-ce9f4319e45c"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಹೌದು"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="6af8efd9-97bb-4562-9079-379894adf887"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="6bfeb754-c64e-4bf7-8c9e-321a40159a9d"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["5"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="465" height="20" uuid="c84a8cc8-4801-4422-95ad-f7d96a964c7d"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಸಹಕಾರಿ ಸಾಲದ ವ್ಯವಸ್ಥೆಗಳ ಅಡಿಯಲ್ಲಿ ಸಾಲ ನೀಡುವ ಸಂದರ್ಭದಲ್ಲಿ (ಉದಾ., ಸಹ-ಸಾಲ/ ಹೊರಗುತ್ತಿಗೆ), ಈ ಕೆಳಗಿನ ಹೆಚ್ಚುವರಿ ವಿವರಗಳನ್ನು ಒದಗಿಸಬಹುದು:"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="1ffed7fa-6ee1-48c1-8e91-149d127bbf49"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="11161cf7-7c6b-473b-9c60-478555caa609"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA[""]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="240" height="20" uuid="6d4b8845-c973-4d6a-ab4b-8cdadc5dac5d"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಹಣಕಾಸು ಅನುಪಾತದ ಜೊತೆಗೆ ಮೂಲ RE ಹೆಸರು / ಪಾಲುದಾರ RE ಅವರ ಹೆಸರು ಮತ್ತು ಅದರ ಅನುಪಾತದ ಹಣ / ಸಂಯೋಜಿತ ಬಡ್ಡಿದರ"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="270" y="0" width="225" height="20" uuid="57040474-905d-4119-9b80-c2aa4e03e1a8"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["N.A. / N.A. / N.A."]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="4e7e08dd-6cf7-43e8-90dd-dce7a5458497"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="a4f338ec-4bdf-4c61-a01e-7bcd52769777"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["6"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="465" height="20" uuid="bd2fc04f-d83b-4a81-afab-04aeb2978b53"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಡಿಜಿಟಲ್ ಸಾಲಗಳ ಸಂದರ್ಭದಲ್ಲಿ, ಈ ಕೆಳಗಿನ ನಿರ್ದಿಷ್ಟ ಬಹಿರಂಗಪಡಿಸುವಿಕೆಗಳನ್ನು ಒದಗಿಸಬಹುದು:"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="b5cca4ea-9286-4eef-b5c5-30306d0e85b6"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="5aa52d1d-5e95-4144-9a92-d4e7a5f0d205"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["(i)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="240" height="20" uuid="348901e1-da44-4ee6-bb12-867292bab41a"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["RE ಮಂಡಳಿಯ ಅನುಮೋದಿತ ನೀತಿಯ ಪ್ರಕಾರ, ಕೂಲಿಂಗ್ ಆಫ್/ಲುಕ್-ಅಪ್ ಅವಧಿ"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="270" y="0" width="225" height="20" uuid="9a1e1ea1-4655-47c3-bad2-cbd357b7b8b3"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["N.A."]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="30c09933-88f7-41b8-a091-34892ab238ca"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="ad46a3b2-3a47-44b0-954e-83635f9da840"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["(ii)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
