					<textFieldExpression><![CDATA["ರೆಫರೆನ್ಸ್ ಬೇಂಚ್ಮಾರ್ಕ್ ಅಲ್ಲಿನ ಬದಲಾವಣೆಯ ಪರಿಣಾಮ ('R' ನಲ್ಲಿ 25 bps ಬದಲಾವಣೆಗೆ, ಬದಲಾಯಿಸಿ :)"]]></textFieldExpression>
