		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="f493914e-9044-4d44-9485-a95e19701bc2"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="8aa30295-254e-4af4-bb29-38f6baa76091"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA["6"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="240" height="20" uuid="95afec15-59b1-496d-aaa8-65db6ccd36c3"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Kannada" size="10" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["ಅನ್ವಯವಾಗುವ ಬಡ್ಡಿದರ (%) ಮತ್ತು ಪ್ರಕಾರ (ಸ್ಥಿರ / ಚರ / ಮಿಶ್ರ) [ಅನ್ವಯವಾಗುವ ಬಡ್ಡಿದರವನ್ನು ಅಂಡರ್‌ರೈಟಿಂಗ್ ಸಮಯದಲ್ಲಿ ನಿರ್ಣಯಿಸಲಾದ ಸಾಲಗಾರನ ಅಪಾಯದ ಪ್ರೊಫೈಲ್ ಆಧರಿಸಿ ನಿರ್ಧರಿಸಲಾಗುತ್ತದೆ. ದರಗಳ ಶ್ರೇಣಿ ಮತ್ತು ಅಪಾಯ-ಆಧಾರಿತ ಶ್ರೇಣೀಕರಣ ಮಾನದಂಡಗಳನ್ನು ಒಳಗೊಂಡಂತೆ ಕಂಪನಿಯ ಬಡ್ಡಿದರ ನೀತಿಯು ಕಂಪನಿಯ ವೆಬ್‌ಸೈಟ್ www.sarvagram.com ನಲ್ಲಿ ಲಭ್ಯವಿದೆ.]"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
