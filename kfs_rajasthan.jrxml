		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="e8a3a4c5-3387-4acf-8953-3b5e4f303a52"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="e10016aa-7819-4560-adb5-8eb6393a9e76"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Devanagari" size="9" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["(xi)"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="140" height="20" uuid="b48d7cb5-b306-4c1e-b161-3db118029b8d"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Devanagari" size="9" isBold="true"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["सामान्य स्थितियां"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="170" y="0" width="325" height="20" uuid="59c1f8a9-8b50-4723-b2ef-92f352d46e15"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Devanagari" size="9"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["I. उधारकर्ता इस बात से सहमत है और ऋणदाता को अधिकृत करता है कि वह ऋणदाता के पास उधारकर्ता की ओर से या उसके द्वारा रखे गए किसी भी खाता से, अभी या भविष्य में, लोन के संबंध में या उससे संबंधित किसी भी और सभी लागतों, प्रभारों और व्ययों की वसूली(रिकवरी) के लिए डेबिट और वसूल करे।\n\nII. उधारकर्ता को मांग किए जाने पर ऋणदाता को पूर्ण भुगतान करना होगा या प्रतिपूर्ति करनी होगी:\na. फाइनेंसिंग/सिक्योरिटी दस्तावेज तैयार करने, प्रतिभूति सृजन आदि की कानूनी लागतें;\nb. सभी लागतें, व्यय और अन्य प्रभार वास्तविक रूप में, जिसमें आवधिक मूल्यांकन, शीर्षक खोज, साइट विजिट, निरीक्षण, बीमा और ऋणदाता को दी गई प्रतिभूति के किसी अन्य तरीके से सुरक्षा/संरक्षण से संबंधित सभी लागतें, व्यय और शुल्क शामिल हैं, परंतु इन्हीं तक सीमित नहीं हैं; और\nc. इस पत्र/ फाइनेंसिंग दस्तावेजों, या किसी वर्तमान या भविष्य की सुरक्षा और अन्य दस्तावेजों के संबंध में अपने किसी भी अधिकार को संरक्षित करने, पूर्ण करने या लागू करने में ऋणदाता द्वारा वहन की गई सभी लागतें (कानूनी फीस सहित)।\n\nIII. उधारकर्ता यह समझता है, स्वीकार करता है और सहमत है कि लोन का न निकाला गया हिस्सा ऋणदाता द्वारा किसी भी समय बिना किसी सूचना के और बिना कोई कारण बताए आंशिक या पूर्ण रूप से रद्द और अस्वीकृत किया जा सकता है।"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="b0ad304a-f821-491c-8777-f6d977467bdc"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="1f880e6f-026c-48a5-89a8-b504656c29f1"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Devanagari" size="9" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA[""]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="140" height="20" uuid="57459281-50eb-4951-9341-c3c11c934f8f"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Devanagari" size="9" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA[""]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="170" y="0" width="325" height="20" uuid="1e50ff26-1ccb-4606-8c3e-c81fa0699e9f"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Devanagari" size="9"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["IV. सभी लागतें, शुल्क, ब्याज दरें लागू करों से अलग हैं।\n\nV. मूल चल/अचल संपत्ति दस्तावेजों को जारी करना: उधारकर्ता, लोन के पूर्ण पुनर्भुगतान/निपटान के 30 (तीस) दिनों के भीतर, उस ब्रांच से मूल चल/अचल संपत्ति दस्तावेज एकत्र कर सकते हैं, जहां लोन खाता सर्विस्ड था।\n\nVI. उधारकर्ता, ऋणदाता को अधिकृत और सहमति देते हैं कि वह उधारकर्ता को बिना किसी पूर्व सूचना के, KYC सूचना सत्यापन, लोन जोखिम विश्लेषण, या अन्य संबंधित उद्देश्यों के लिए ऋणदाता की अन्य ब्रांच, सहायक कंपनियों, समूह कंपनियों, क्रेडिट ब्यूरो, रेटिंग एजेंसियों, बैंकों/वित्तीय संस्थानों, सरकार/नियामक प्राधिकरणों या थर्ड पार्टी को जानकारी प्रकट कर सकता है; तथा गोपनीयता के विशेषाधिकार का त्याग करते हैं।\n\nVII. लागू ब्याज दर और अन्य मूल्य निर्धारण मापदंडों में परिवर्तन की सूचना ऋणदाता द्वारा ईमेल, पत्र, वेबसाइट, खाता विवरण, SMS के माध्यम से या इसकी ब्रांच के माध्यम से दी जा सकती है।"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="25" splitType="Stretch">
			<break>
