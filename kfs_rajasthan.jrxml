				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="8aa30295-254e-4af4-bb29-38f6baa76091"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Devanagari" size="10" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA["6"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="30" y="0" width="240" height="20" uuid="95afec15-59b1-496d-aaa8-65db6ccd36c3"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Devanagari" size="10" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["लागू ब्याज दर (%) और प्रकार (निश्चित, परिवर्तनशील या हाइब्रिड) [लागू ब्याज दर का निर्धारण ऋण के जोखिम प्रोफाइल के आकलन के आधार पर किया गया है, जिसका आकलन ऋण मूल्यांकन के समय किया गया था। कंपनी की ब्याज दर नीति, जिसमें दरों की सीमा और जोखिम-आधारित वर्गीकरण पैरामीटर शामिल हैं, कंपनी की वेबसाइट www.sarvagram.com पर उपलब्ध है।]"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="TC" stretchType="ContainerHeight" x="270" y="0" width="225" height="20" uuid="22c6a025-543d-486b-b418-e24674494b8a"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Devanagari" size="10"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{roi} + " तय"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="20" splitType="Stretch">
			<frame>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="2124a4de-34a7-4afe-b2d7-9236591e903a"/>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="0" y="0" width="30" height="20" uuid="c57eb41f-2733-4754-b1cd-a43282e47d65"/>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font fontName="Noto Sans Devanagari" size="10" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA["7"]]></textFieldExpression>
