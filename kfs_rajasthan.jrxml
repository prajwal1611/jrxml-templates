				<textElement textAlignment="Justified">
					<font fontName="Noto Sans Devanagari" size="9" isItalic="true"/>
				</textElement>
				<textFieldExpression><![CDATA["** यह पुनर्भुगतान कार्यक्रम अस्थायी है। अंतिम पुनर्भुगतान कार्यक्रम लोन के वितरण के बाद अलग से प्रदान किया जाएगा और इसमें लोन के पुनर्भुगतान की सटीक देय तिथियों, मूलधन और ब्याज के बीच का अंतर, पुनर्भुगतान की शुरुआत की सटीक तिथि आदि से संबंधित विवरण शामिल होंगे।"]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
