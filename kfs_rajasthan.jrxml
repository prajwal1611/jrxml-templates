						<font fontName="Noto Sans Devanagari" size="10" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["डिजिटल लोन के मामले में, निम्नलिखित विशिष्ट डिसक्लोज़र प्रस्तुत किए जा सकते हैं:"]]></textFieldExpression>
