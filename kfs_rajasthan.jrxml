						<font fontName="Noto Sans Devanagari" size="10" isBold="false"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["संवितरण अनुसूची\n(i) चरणों में संवितरण या 100% अग्रिम\n(ii) यदि यह चरणवार है, तो प्रासंगिक विवरण वाले ऋण अनुबंध के वर्ग का उल्लेख करें"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="TC" stretchType="ContainerHeight" x="270" y="0" width="225" height="20" uuid="64782983-4f9e-4519-a6e2-7167791c3820"/>
					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Noto Sans Devanagari" size="10"/>
						<paragraph leftIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["जैसा कि नीचे भाग 3(vii) में दिया गया है।"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
